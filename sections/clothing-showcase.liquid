{% comment %}
  Clothing Showcase Section - Displays products from a collection
{% endcomment %}

<section id="clothing" class="py-24 md:py-32 bg-background">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-4">
        {{ section.settings.heading | default: "Premium Clothing Collection" }}
      </h2>
      <p class="text-lg text-foreground/60 max-w-xl mx-auto">
        {{ section.settings.description | default: "Discover our curated selection of premium clothing for every style." }}
      </p>
    </div>

    {%- assign collection = nil -%}
    {%- if section.settings.collection != blank -%}
      {%- assign collection = collections[section.settings.collection] -%}
    {%- endif -%}
    {%- if collection == nil and collections['frontpage'] != blank -%}
      {%- assign collection = collections['frontpage'] -%}
    {%- endif -%}
    {%- if collection != blank and collection.products.size > 0 -%}
        {% render 'amazon-disclosure' %}
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 product-grid product-grid--ads">
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            {%- assign view_url = product.url -%}
            {%- assign matched_block = nil -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'amazon_link' and block.settings.product != blank -%}
                {%- if block.settings.product.id == product.id -%}
                  {%- if block.settings.url != blank -%}
                    {%- assign view_url = block.settings.url -%}
                  {%- endif -%}
                  {%- assign matched_block = block -%}
                  {%- break -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if matched_block == nil -%}
              {%- assign title_lower = product.title | downcase -%}
              {%- if title_lower contains "athletic fit tee" or title_lower contains "athletic fit tees" -%}
                {%- assign view_url = "https://amzn.to/45I1l6l" -%}
              {%- elsif title_lower contains "coofandy" and title_lower contains "short" and title_lower contains "button" -%}
                {%- assign view_url = "https://amzn.to/4komatB" -%}
              {%- elsif title_lower contains "soly hux" and title_lower contains "textured" -%}
                {%- assign view_url = "https://amzn.to/3NUPlbB" -%}
              {%- elsif title_lower contains "jbl tune flex" -%}
                {%- assign view_url = "https://amzn.to/4rRscFy" -%}
              {%- endif -%}
            {%- endif -%}
            <div class="product-card product-card--ad group relative bg-card rounded-3xl overflow-hidden border-2 border-border/50 hover:border-accent/40 shadow-lg hover:shadow-accent/10"{% if matched_block %} {{ matched_block.shopify_attributes }}{% endif %}>
              <span class="product-card__ad-badge" aria-hidden="true">{{ 'general.amazon.sponsored' | t | default: 'Sponsored' }}</span>
              <div class="aspect-[4/5] relative overflow-hidden">
                {%- if product.featured_image != blank -%}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
                {%- endif -%}
                <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-background/20 to-transparent"></div>
              </div>
              <div class="absolute bottom-0 left-0 right-0 product-card-overlay-inner">
                <div class="absolute inset-0 bg-background/40 backdrop-blur-sm rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="relative z-10">
                  {%- if product.vendor != blank -%}
                    <p class="product-card-tagline font-medium text-accent uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity duration-300">{{ product.vendor }}</p>
                  {%- elsif product.metafields.custom.tagline != blank -%}
                    <p class="product-card-tagline font-medium text-accent uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity duration-300">{{ product.metafields.custom.tagline }}</p>
                  {%- endif -%}
                  <h3 class="product-card-title font-bold text-foreground opacity-0 group-hover:opacity-100 transition-opacity duration-300" title="{{ product.title | escape }}">{{ product.title }}</h3>
                  {%- if product.description != blank -%}
                    <p class="product-card-desc text-foreground/60 max-w-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300 line-clamp-2">{{ product.description | strip_html | truncate: 100 }}</p>
                  {%- endif -%}
                  <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <a href="{{ view_url }}" class="btn-hero text-xs" target="_blank" rel="noopener noreferrer{% if view_url contains 'amzn.to' %} sponsored{% endif %}">{% if view_url contains 'amzn.to' %}{% if section.settings.button_text_amazon != blank %}{{ section.settings.button_text_amazon }}{% else %}{{ 'general.amazon.view_on_amazon' | t | default: 'View on Amazon' }}{% endif %}{% else %}{% if section.settings.button_text_product != blank %}{{ section.settings.button_text_product }}{% else %}{{ 'general.amazon.view_product' | t | default: 'View product' }}{% endif %}{% endif %}</a>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
    {%- else -%}
      <p class="text-center text-foreground/60">No products to show. In the sidebar under "Products in grid", select a Collection that has products.</p>
    {%- endif -%}
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

{% schema %}
{
  "name": "Clothing Showcase",
  "settings": [
    {
      "type": "header",
      "content": "Products in grid"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Choose the collection. Products from this collection appear in the grid above. Defaults to Homepage collection if empty."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium Clothing Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our curated selection of premium clothing for every style."
    },
    {
      "type": "header",
      "content": "Button labels"
    },
    {
      "type": "text",
      "id": "button_text_amazon",
      "label": "View on Amazon button text",
      "default": "View on Amazon",
      "info": "Shown when the product link goes to Amazon."
    },
    {
      "type": "text",
      "id": "button_text_product",
      "label": "View product button text",
      "default": "View product",
      "info": "Shown when the product uses a non-Amazon link."
    },
    {
      "type": "header",
      "content": "Product links"
    },
    {
      "type": "paragraph",
      "content": "Below: click 'Add block' or 'Add product link' to add a product and its button URL. Each block = one product + one link."
    }
  ],
  "blocks": [
    {
      "type": "amazon_link",
      "name": "Product link",
      "limit": 50,
      "settings": [
        {
          "type": "header",
          "content": "Product and link"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Select the product. This block's link will be used for its button."
        },
        {
          "type": "text",
          "id": "url",
          "label": "Link URL",
          "placeholder": "https://amzn.to/xxxxx or any URL",
          "info": "Paste the full URL for the View product button."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clothing Showcase",
      "blocks": [
        {
          "type": "amazon_link",
          "settings": {}
        }
      ]
    }
  ]
}
{% endschema %}
