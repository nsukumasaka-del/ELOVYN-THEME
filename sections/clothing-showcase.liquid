{% comment %}
  Clothing Showcase Section - Displays products from a collection with price and Add to cart.
  No product link blocks; all products use standard Add to cart.
{% endcomment %}

<section id="{{ section.settings.section_id | default: 'apparel' }}" class="clothing-showcase-section py-24 md:py-32 bg-background">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-4">
        {{ section.settings.heading | default: "Premium Clothing Collection" }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="text-lg text-foreground/60 max-w-xl mx-auto">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    {%- assign collection = nil -%}
    {%- if section.settings.collection != blank -%}
      {%- assign collection = collections[section.settings.collection] -%}
    {%- endif -%}
    {%- if collection == nil and collections['frontpage'] != blank -%}
      {%- assign collection = collections['frontpage'] -%}
    {%- endif -%}

    {% if collection != blank and collection.products.size > 0 %}
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 product-grid gap-4 md:gap-6">
        {% for product in collection.products limit: section.settings.products_to_show %}
          {%- assign current_variant = product.selected_or_first_available_variant -%}
          <div class="product-card-shop clothing-showcase-card">
            <a href="{{ product.url }}" class="clothing-showcase-card-image">
              {% if product.featured_image != blank %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="300"
                  height="375"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'clothing-showcase-placeholder' }}
              {% endif %}
              {% if current_variant.available == false %}
                <span class="clothing-showcase-soldout">{{ 'products.product.sold_out' | t }}</span>
              {% endif %}
            </a>
            <div class="clothing-showcase-card-content">
              <a href="{{ product.url }}" class="clothing-showcase-title">{{ product.title }}</a>
              {% if product.description != blank %}
                <p class="clothing-showcase-desc">{{ product.description | strip_html | truncate: 80 }}</p>
              {% endif %}
              <div class="clothing-showcase-price-row">
                <span class="clothing-showcase-price">{{ current_variant.price | money }}</span>
                {% if current_variant.compare_at_price > current_variant.price %}
                  <span class="clothing-showcase-compare">{{ current_variant.compare_at_price | money }}</span>
                  <span class="clothing-showcase-badge">{{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}% off</span>
                {% endif %}
              </div>
              {% if product.has_only_default_variant %}
                {% if current_variant.available %}
                  <form action="{{ routes.cart_add_url }}" method="post" class="clothing-showcase-form">
                    <input type="hidden" name="id" value="{{ current_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" name="add" class="clothing-showcase-btn clothing-showcase-btn-add">
                      {{ 'products.product.add_to_cart' | t }}
                    </button>
                  </form>
                {% else %}
                  <button type="button" disabled class="clothing-showcase-btn clothing-showcase-btn-soldout">{{ 'products.product.sold_out' | t }}</button>
                {% endif %}
              {% else %}
                <a href="{{ product.url }}" class="clothing-showcase-btn clothing-showcase-btn-add">{{ 'products.product.add_to_cart' | t }}</a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.show_view_all and collection.url != blank %}
        <div class="text-center mt-10">
          <a href="{{ collection.url }}" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-border text-foreground font-semibold hover:bg-card transition-colors">
            {{ section.settings.view_all_text | default: 'View all' }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <p class="text-center text-foreground/60">No products to show. In the sidebar under "Collection", select a collection that has products.</p>
    {% endif %}
  </div>
</section>

<style>
  /* Clothing Showcase – modern product cards & Add to cart */
  .clothing-showcase-section .product-card-shop {
    display: flex;
    flex-direction: column;
    background: hsl(var(--card));
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid hsl(var(--border) / 0.5);
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .clothing-showcase-section .product-card-shop:hover {
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
    border-color: hsl(var(--border));
  }

  .clothing-showcase-card-image {
    display: block;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    flex-shrink: 0;
    text-decoration: none;
    color: inherit;
  }
  .clothing-showcase-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .clothing-showcase-section .product-card-shop:hover .clothing-showcase-card-image img {
    transform: scale(1.05);
  }
  .clothing-showcase-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: hsl(var(--secondary));
  }
  .clothing-showcase-soldout {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: hsl(var(--background) / 0.75);
    color: hsl(var(--foreground));
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .clothing-showcase-card-content {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background: hsl(var(--card));
    color: hsl(var(--foreground));
    flex: 1 1 auto;
    min-height: 0;
  }
  .clothing-showcase-title {
    font-size: 1rem;
    font-weight: 600;
    color: hsl(var(--foreground));
    text-decoration: none;
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.35;
    transition: color 0.2s ease;
  }
  .clothing-showcase-title:hover {
    color: hsl(var(--accent));
  }
  .clothing-showcase-desc {
    font-size: 0.8125rem;
    color: hsl(var(--foreground) / 0.7);
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.4;
  }
  .clothing-showcase-price-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .clothing-showcase-price {
    font-size: 1.125rem;
    font-weight: 700;
    color: hsl(var(--foreground));
  }
  .clothing-showcase-compare {
    font-size: 0.875rem;
    color: hsl(var(--foreground) / 0.5);
    text-decoration: line-through;
  }
  .clothing-showcase-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    background: hsl(var(--accent) / 0.2);
    color: hsl(var(--accent));
  }

  .clothing-showcase-form {
    margin: 0;
    display: block;
  }
  .clothing-showcase-btn {
    display: block;
    width: 100%;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.15s ease;
    box-sizing: border-box;
  }
  .clothing-showcase-btn-add {
    background: hsl(var(--accent));
    color: hsl(var(--accent-foreground));
  }
  .clothing-showcase-btn-add:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }
  .clothing-showcase-btn-add:active {
    transform: translateY(0);
  }
  .clothing-showcase-btn-soldout {
    background: hsl(var(--muted));
    color: hsl(var(--muted-foreground));
    cursor: not-allowed;
  }
</style>

{% schema %}
{
  "name": "Clothing Showcase",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID (for anchor links)",
      "default": "apparel",
      "info": "Optional. e.g. featured, hoodies. Leave as 'apparel' if not using anchor links."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products from this collection appear with price and Add to cart. Defaults to Homepage collection if empty."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium Clothing Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our curated selection of premium clothing for every style."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all button text",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Clothing Showcase"
    }
  ]
}
{% endschema %}
