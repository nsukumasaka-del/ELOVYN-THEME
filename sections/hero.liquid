{% comment %}
  Hero section with background image and call-to-action.
  Shop Now button uses white modern style (replaced from nav bar).
{% endcomment %}

<style>
  .elovyn-hero-shop-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #111;
    background: #fff;
    border: none;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
    transition: background 0.25s ease, box-shadow 0.25s ease, transform 0.2s ease;
  }
  .elovyn-hero-shop-btn:hover {
    background: #f8f8f8;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    transform: translateY(-1px);
  }
  @media (min-width: 768px) {
    .elovyn-hero-shop-btn { padding: 0.875rem 2rem; font-size: 0.9375rem; }
  }
</style>

<section
  class="relative w-full overflow-hidden hero-section"
  style="height: {{ section.settings.hero_height | default: 80 }}vh;"
  data-section-id="{{ section.id }}"
>
  {%- comment -%} Background Image (zoom + focal point via CSS background) {%- endcomment -%}
  {%- if section.settings.hero_image != blank -%}
    {%- assign hero_bg_url = section.settings.hero_image | image_url: width: 1920 -%}
  {%- else -%}
    {%- assign hero_bg_url = 'hoodie.png' | asset_url -%}
  {%- endif -%}
  {%- assign hero_zoom = section.settings.hero_zoom | default: 100 -%}
  {%- assign hero_focal = section.settings.hero_focal_point | default: 'center' -%}
  <div
    class="absolute inset-0 hero-bg"
    role="img"
    aria-label="{% if section.settings.hero_image != blank %}{{ section.settings.hero_image.alt | default: 'Hero background' | escape }}{% else %}Hero background{% endif %}"
    style="background-image: url('{{ hero_bg_url }}'); background-size: {{ hero_zoom }}%; background-position: {{ hero_focal }}; background-repeat: no-repeat; background-attachment: scroll;"
  ></div>
  <style>
    @media (max-width: 768px) {
      #shopify-section-{{ section.id }} .hero-bg {
        background-size: {{ section.settings.hero_zoom_mobile }}% !important;
        background-position: {{ section.settings.hero_focal_point_mobile }} !important;
      }
    }
  </style>
  <div class="absolute inset-0 bg-gradient-to-r from-background/80 via-background/40 to-transparent" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent" aria-hidden="true"></div>

  {%- comment -%} Content {%- endcomment -%}
  <div class="relative z-10 h-full flex flex-col justify-center container mx-auto px-6">
    <div class="max-w-2xl">
      <h3 class="text-4xl md:text-6xl lg:text-7xl font-bold leading-[0.95] tracking-tight text-foreground mb-6 font-playfair italic text-shadow">
        {{ section.settings.heading | default: "Hoodies." }}
        <br>
        {{ section.settings.subheading | default: "Timeless feel." }}
      </h3>
      <p class="text-lg md:text-xl text-foreground/70 mb-8">
        {{ section.settings.description | default: "Find our latest products below." }}
      </p>
      <div>
        <a 
          href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}/collections/shirts{% endif %}" 
          class="elovyn-hero-shop-btn"
        >
          {{ section.settings.button_text | default: "Shop Now" }}
        </a>
      </div>
    </div>

    {%- comment -%} Bottom Features Bar {%- endcomment -%}
    <div class="absolute bottom-8 left-6 right-6">
      <div class="container mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 py-6 border-t border-foreground/10">
          {%- for block in section.blocks -%}
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center">
                <span class="text-sm font-bold text-accent">{{ block.settings.icon }}</span>
              </div>
              <div>
                <p class="text-sm font-medium text-foreground">{{ block.settings.title }}</p>
                <p class="text-xs text-foreground/50">{{ block.settings.subtitle }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Hero height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 80
    },
    {
      "type": "range",
      "id": "hero_zoom",
      "label": "Hero image zoom (%)",
      "min": 50,
      "max": 150,
      "step": 5,
      "default": 100,
      "info": "Scale the image (50%–150%). Higher = more zoomed in."
    },
    {
      "type": "select",
      "id": "hero_focal_point",
      "label": "Hero image focal point",
      "options": [
        { "value": "top left", "label": "Top Left" },
        { "value": "top center", "label": "Top Center" },
        { "value": "top right", "label": "Top Right" },
        { "value": "center left", "label": "Center Left" },
        { "value": "center", "label": "Center" },
        { "value": "center right", "label": "Center Right" },
        { "value": "bottom left", "label": "Bottom Left" },
        { "value": "bottom center", "label": "Bottom Center" },
        { "value": "bottom right", "label": "Bottom Right" }
      ],
      "default": "center",
      "info": "Which part of the image is visible in the hero."
    },
    {
      "type": "header",
      "content": "Mobile (optional)"
    },
    {
      "type": "range",
      "id": "hero_zoom_mobile",
      "label": "Hero image zoom on mobile (%)",
      "min": 50,
      "max": 150,
      "step": 5,
      "default": 100,
      "info": "Leave at 100 to match desktop."
    },
    {
      "type": "select",
      "id": "hero_focal_point_mobile",
      "label": "Hero focal point on mobile",
      "options": [
        { "value": "top left", "label": "Top Left" },
        { "value": "top center", "label": "Top Center" },
        { "value": "top right", "label": "Top Right" },
        { "value": "center left", "label": "Center Left" },
        { "value": "center", "label": "Center" },
        { "value": "center right", "label": "Center Right" },
        { "value": "bottom left", "label": "Bottom Left" },
        { "value": "bottom center", "label": "Bottom Center" },
        { "value": "bottom right", "label": "Bottom Right" }
      ],
      "default": "center",
      "info": "Leave as Center to match desktop."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hoodies."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Sweatshirts. Graphic tees."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Premium comfort and style. Shop our curated collection of hoodies, sweatshirts, and custom graphic tees."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji or text)",
          "default": "★"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium comfort"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Hoodies, sweatshirts & tees"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
