{% comment %}
  Customer registration (sign up) page section.
{% endcomment %}

<section class="py-16 md:py-24 bg-background">
  <div class="container mx-auto px-6">
    <div class="max-w-md mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-8">
        {{ 'customer.register.title' | t | default: 'Create account' }}
      </h1>

      {% form 'create_customer', novalidate: 'novalidate', class: 'space-y-5' %}
        {% if form.errors %}
          <div class="rounded-xl border border-red-500/50 bg-red-500/10 p-4 text-foreground" role="alert">
            <p class="font-semibold mb-2">{{ 'templates.contact.form.error_heading' | t | default: 'Please fix the errors below.' }}</p>
            <ul class="list-disc list-inside text-sm space-y-1">
              {% for field in form.errors %}
                <li>
                  {% if field == 'form' %}
                    {{ form.errors.messages[field] }}
                  {% else %}
                    <a href="#RegisterForm-{{ field }}" class="underline">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        <div>
          <label for="RegisterForm-FirstName" class="block text-sm font-medium text-foreground mb-1">{{ 'customer.register.first_name' | t | default: 'First name' }}</label>
          <input type="text" name="customer[first_name]" id="RegisterForm-FirstName" value="{{ form.first_name }}" autocomplete="given-name" class="w-full px-4 py-3 rounded-xl border border-border bg-card text-foreground placeholder:text-foreground/50 focus:outline-none focus:ring-2 focus:ring-accent">
        </div>
        <div>
          <label for="RegisterForm-LastName" class="block text-sm font-medium text-foreground mb-1">{{ 'customer.register.last_name' | t | default: 'Last name' }}</label>
          <input type="text" name="customer[last_name]" id="RegisterForm-LastName" value="{{ form.last_name }}" autocomplete="family-name" class="w-full px-4 py-3 rounded-xl border border-border bg-card text-foreground placeholder:text-foreground/50 focus:outline-none focus:ring-2 focus:ring-accent">
        </div>
        <div>
          <label for="RegisterForm-email" class="block text-sm font-medium text-foreground mb-1">{{ 'customer.register.email' | t | default: 'Email' }}</label>
          <input type="email" name="customer[email]" id="RegisterForm-email" value="{{ form.email }}" spellcheck="false" autocapitalize="off" autocomplete="email" required class="w-full px-4 py-3 rounded-xl border border-border bg-card text-foreground placeholder:text-foreground/50 focus:outline-none focus:ring-2 focus:ring-accent {% if form.errors contains 'email' %}border-red-500{% endif %}">
          {% if form.errors contains 'email' %}
            <p class="mt-1 text-sm text-red-400">{{ form.errors.messages.email }}</p>
          {% endif %}
        </div>
        <div>
          <label for="RegisterForm-password" class="block text-sm font-medium text-foreground mb-1">{{ 'customer.register.password' | t | default: 'Password' }}</label>
          <input type="password" name="customer[password]" id="RegisterForm-password" required class="w-full px-4 py-3 rounded-xl border border-border bg-card text-foreground placeholder:text-foreground/50 focus:outline-none focus:ring-2 focus:ring-accent {% if form.errors contains 'password' %}border-red-500{% endif %}">
          {% if form.errors contains 'password' %}
            <p class="mt-1 text-sm text-red-400">{{ form.errors.messages.password }}</p>
          {% endif %}
        </div>
        <button type="submit" class="w-full py-3.5 px-6 rounded-xl bg-accent text-accent-foreground font-semibold hover:opacity-90 transition-opacity">
          {{ 'customer.register.submit' | t | default: 'Create' }}
        </button>
      {% endform %}

      <p class="mt-6 text-center text-foreground/60 text-sm">
        <a href="{{ routes.account_login_url }}" class="text-accent hover:underline">{{ 'customer.login.title' | t | default: 'Log in' }}</a>
        {{ 'customer.register.or' | t | default: ' if you already have an account.' }}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Register",
  "settings": []
}
{% endschema %}
