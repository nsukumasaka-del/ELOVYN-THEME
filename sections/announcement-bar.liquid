<section class="announcement-bar-section" role="region" aria-label="Store announcement">
  <div class="announcement-bar__content">
    <p class="announcement-bar__message">
      {{ section.settings.message | default: 'FREE SHIPPING ON ORDERS OVER R500 | NEW DROPS EVERY FRIDAY' }}
    </p>
  </div>
</section>

<style>
  .announcement-bar-section {
    background: var(--color-accent, #FF3333);
    color: #fff;
    text-align: center;
    padding: 0.5rem 1rem;
    position: relative;
    z-index: 100001;
  }
  .announcement-bar__message {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  @media (max-width: 640px) {
    .announcement-bar__message { font-size: 0.68rem; letter-spacing: 0.07em; }
  }
</style>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "FREE SHIPPING ON ORDERS OVER R500 | NEW DROPS EVERY FRIDAY"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
