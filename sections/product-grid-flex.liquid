<section class="product-grid-flex section-spacing">
  <div class="container mx-auto px-6">
    {%- if section.settings.heading != blank -%}
      <div class="text-center mb-10">
        <h2 class="text-4xl md:text-5xl font-bold text-foreground mb-3">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="text-foreground/70 max-w-2xl mx-auto">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign selected_collection = collections[section.settings.collection] -%}
    {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {%- for product in selected_collection.products limit: section.settings.products_to_show -%}
          <article class="product-grid-flex__card">
            <a href="{{ product.url }}" class="product-grid-flex__image-link">
              {%- if product.featured_image != blank -%}
                <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'product-grid-flex__placeholder' }}
              {%- endif -%}
            </a>
            <div class="product-grid-flex__body">
              <a href="{{ product.url }}" class="product-grid-flex__title">{{ product.title }}</a>
              <div class="product-grid-flex__price">{{ product.price | money }}</div>
              <a href="{{ product.url }}" class="product-grid-flex__button">{{ section.settings.button_text | default: 'View product' }}</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if section.settings.show_view_all and selected_collection.url != blank -%}
        <div class="text-center mt-8">
          <a href="{{ selected_collection.url }}" class="product-grid-flex__view-all">{{ section.settings.view_all_text | default: 'View all' }}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="text-center text-foreground/60">Choose a collection with products in this section settings.</p>
    {%- endif -%}
  </div>
</section>

<style>
  .product-grid-flex__card { background: hsl(var(--card)); border: 1px solid hsl(var(--border) / 0.5); border-radius: 14px; overflow: hidden; }
  .product-grid-flex__image-link { display: block; aspect-ratio: 4/5; overflow: hidden; }
  .product-grid-flex__image-link img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .product-grid-flex__body { padding: 0.9rem; }
  .product-grid-flex__title { color: hsl(var(--foreground)); text-decoration: none; font-weight: 600; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .product-grid-flex__price { margin-top: 0.45rem; font-weight: 700; color: hsl(var(--foreground)); }
  .product-grid-flex__button { margin-top: 0.6rem; display: inline-flex; text-decoration: none; background: hsl(var(--accent)); color: hsl(var(--accent-foreground)); padding: 0.5rem 0.8rem; border-radius: 9px; font-size: 0.82rem; font-weight: 600; }
  .product-grid-flex__view-all { text-decoration: none; color: hsl(var(--foreground)); border: 1px solid hsl(var(--border)); padding: 0.6rem 1rem; border-radius: 999px; display: inline-flex; }
</style>

{% schema %}
{
  "name": "Product grid (flex)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured Products" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Highlight your best products here." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "button_text", "label": "Product button text", "default": "View product" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View all link", "default": true },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "View all" }
  ],
  "presets": [
    { "name": "Product grid (flex)" }
  ]
}
{% endschema %}
