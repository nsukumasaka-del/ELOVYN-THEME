{% comment %}
  Short brand story section.
{% endcomment %}

<section class="brand-story-section py-16 md:py-24">
  <div class="container mx-auto px-6">
    <div class="brand-story-wrap">
      <div class="brand-story-copy">
        <h2 class="brand-story-heading">{{ section.settings.heading | default: "Built for comfort. Designed to stand out." }}</h2>
        <p class="brand-story-text">
          {{ section.settings.text | default: "Elovyn creates modern hoodies, sweatshirts, and graphic tees made for self-expression, confidence, and everyday comfort." }}
        </p>
      </div>
      {%- if section.settings.image != blank or section.settings.image_url != blank -%}
        <div class="brand-story-image-wrap">
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1200 }}"
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              loading="lazy"
              class="brand-story-image"
            >
          {%- else -%}
            <img
              src="{{ section.settings.image_url }}"
              alt="{{ section.settings.heading | escape }}"
              loading="lazy"
              class="brand-story-image"
            >
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .brand-story-wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border) / 0.6);
    border-radius: 1rem;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .brand-story-wrap { grid-template-columns: 1.1fr 1fr; }
  }
  .brand-story-copy { padding: 1.25rem; }
  @media (min-width: 768px) {
    .brand-story-copy { padding: 2rem; }
  }
  .brand-story-heading {
    margin: 0 0 0.75rem;
    color: hsl(var(--foreground));
    font-size: clamp(1.4rem, 3.3vw, 2rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .brand-story-text {
    margin: 0;
    color: hsl(var(--foreground) / 0.72);
    line-height: 1.65;
    font-size: 0.95rem;
    max-width: 55ch;
  }
  .brand-story-image-wrap { min-height: 220px; }
  .brand-story-image {
    width: 100%;
    height: 100%;
    min-height: 220px;
    object-fit: cover;
    display: block;
  }
</style>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for comfort. Designed to stand out." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Elovyn creates modern hoodies, sweatshirts, and graphic tees made for self-expression, confidence, and everyday comfort." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "Image URL (optional)", "info": "Optional fallback URL if no image is uploaded." }
  ],
  "presets": [
    { "name": "Brand story" }
  ]
}
{% endschema %}
