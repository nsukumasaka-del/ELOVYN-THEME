{% comment %}
  Collection page section - displays collection title, description, and product grid.
  Dropshipping collections (graphic-tees, custom-tees, jfuncy-...) show price + Add to cart.
{% endcomment %}

{%- assign dropshipping_handles = "graphic-tees,custom-tees,jfuncy-s-6xl-oversize-men-cotton-tee-tops,shirts" | split: "," -%}
{%- assign is_dropshipping = false -%}
{%- for handle in dropshipping_handles -%}
  {%- if collection.handle == handle -%}
    {%- assign is_dropshipping = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<section class="py-16 md:py-24 bg-background">
  <div class="container mx-auto px-6">
    <header class="text-center mb-12 md:mb-16">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-4">
        {{ collection.title }}
      </h1>
      {% if collection.description != blank %}
        <div class="text-lg text-foreground/60 max-w-2xl mx-auto prose prose-invert">
          {{ collection.description }}
        </div>
      {% endif %}
    </header>

    {% if collection.products.size > 0 %}
      {% if is_dropshipping %}
        {%- comment -%} Dropshipping (custom-tees, graphic-tees, etc.): all products show price + Add to cart, no sold-out UI. {%- endcomment -%}
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 product-grid gap-4 md:gap-6">
          {% for product in collection.products %}
            {%- assign current_variant = product.selected_or_first_available_variant -%}
            <div class="product-card-shop group bg-card rounded-2xl overflow-hidden border border-border/40 hover:border-border hover:shadow-xl hover:shadow-black/20 transition-all duration-300">
              <a href="{{ product.url }}" class="block aspect-[4/5] relative overflow-hidden">
                {% if product.featured_image != blank %}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" width="300" height="375">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover bg-secondary' }}
                {% endif %}
              </a>
              <div class="p-4 md:p-5" style="padding: 1rem; background-color: hsl(var(--card));">
                <a href="{{ product.url }}" class="font-semibold text-foreground hover:text-accent transition-colors line-clamp-2 block mb-2">{{ product.title }}</a>
                {% if product.description != blank %}
                  <p class="text-sm text-foreground/70 line-clamp-2 mb-2">{{ product.description | strip_html | truncate: 80 }}</p>
                {% endif %}
                <div class="flex items-center gap-2 mb-3 flex-wrap">
                  <span class="text-lg font-bold text-foreground">{{ current_variant.price | money }}</span>
                  {% if current_variant.compare_at_price > current_variant.price %}
                    <span class="text-sm text-foreground/50 line-through">{{ current_variant.compare_at_price | money }}</span>
                    <span class="text-xs font-medium text-accent bg-accent/20 px-1.5 py-0.5 rounded">{{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}% off</span>
                  {% endif %}
                </div>
                <form action="{{ routes.cart_add_url }}" method="post" class="cart-add-form" data-collection-add-to-cart>
                  <input type="hidden" name="id" value="{{ current_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" name="add" class="w-full py-2.5 px-4 rounded-xl bg-accent text-accent-foreground font-semibold text-sm hover:opacity-90 transition-opacity">{{ 'products.product.add_to_cart' | t }}</button>
                </form>
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        {% render 'amazon-disclosure' %}
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 product-grid product-grid--ads">
          {% for product in collection.products %}
            {%- assign view_url = product.url -%}
            {%- assign title_lower = product.title | downcase -%}
            {%- if title_lower contains "athletic fit tee" or title_lower contains "athletic fit tees" -%}
              {%- assign view_url = "https://amzn.to/45I1l6l" -%}
            {%- elsif title_lower contains "coofandy" and title_lower contains "short" and title_lower contains "button" -%}
              {%- assign view_url = "https://amzn.to/4komatB" -%}
            {%- elsif title_lower contains "soly hux" and title_lower contains "textured" -%}
              {%- assign view_url = "https://amzn.to/3NUPlbB" -%}
            {%- elsif title_lower contains "jbl tune flex" -%}
              {%- assign view_url = "https://amzn.to/4rRscFy" -%}
            {%- endif -%}
            <div class="product-card product-card--ad group relative bg-card rounded-3xl overflow-hidden border-2 border-border/50 hover:border-accent/40">
              <span class="product-card__ad-badge" aria-hidden="true">{{ 'general.amazon.sponsored' | t | default: 'Sponsored' }}</span>
              <div class="aspect-[4/5] relative overflow-hidden">
                {% if product.featured_image != blank %}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
                {% endif %}
              </div>
              <div class="absolute bottom-0 left-0 right-0 product-card-overlay-inner">
                <div class="absolute inset-0 bg-background/30 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="relative z-10">
                  {% if product.vendor != blank %}
                    <p class="product-card-tagline font-medium text-accent uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity duration-300">{{ product.vendor }}</p>
                  {% endif %}
                  <h2 class="product-card-title font-bold text-foreground opacity-0 group-hover:opacity-100 transition-opacity duration-300" title="{{ product.title | escape }}">
                    {{ product.title }}
                  </h2>
                  {% if product.description != blank %}
                    <p class="product-card-desc text-foreground/60 max-w-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300 line-clamp-2">{{ product.description | strip_html | truncate: 100 }}</p>
                  {% endif %}
                  <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <a href="{{ view_url }}" class="btn-hero text-xs" target="_blank" rel="noopener noreferrer{% if view_url contains 'amzn.to' %} sponsored{% endif %}">{% if view_url contains 'amzn.to' %}{{ 'general.amazon.view_on_amazon' | t | default: 'View on Amazon' }}{% else %}{{ 'general.amazon.view_product' | t | default: 'View product' }}{% endif %}</a>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav class="mt-12 flex justify-center gap-2 flex-wrap" aria-label="Pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="px-4 py-2 rounded-lg border border-border text-foreground hover:bg-card">{{ 'general.pagination.previous' | t | default: 'Previous' }}</a>
          {% endif %}
          <span class="px-4 py-2 text-foreground/70">{{ 'general.pagination.current_page' | t: current: paginate.current_page, total: paginate.pages }}</span>
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="px-4 py-2 rounded-lg border border-border text-foreground hover:bg-card">{{ 'general.pagination.next' | t | default: 'Next' }}</a>
          {% endif %}
        </nav>
      {% endif %}
    {% else %}
      <p class="text-center text-foreground/60">{{ 'collections.general.no_matches' | t | default: 'No products in this collection.' }}</p>
    {% endif %}
  </div>
</section>
{% if is_dropshipping %}
<style>
  .product-card-shop .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
<script>
(function() {
  var forms = document.querySelectorAll('form[data-collection-add-to-cart]');
  if (!forms.length) return;
  var cartUrl = (window.routes && window.routes.cart_url) || '/cart';
  var cartAddUrl = (window.routes && window.routes.cart_add_url) || '';
  var addUrl = cartAddUrl ? cartAddUrl.replace(/\/add\/?(\?.*)?$/i, '') + '/add.js' : '/cart/add.js';
  function showToast(msg, isError) {
    var id = 'collection-add-toast';
    var existing = document.getElementById(id);
    if (existing) existing.remove();
    var toast = document.createElement('div');
    toast.id = id;
    toast.setAttribute('style', 'position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%) translateY(100px);z-index:9999;padding:0.875rem 1.25rem;background:hsl(var(--card));border:1px solid hsl(var(--border));border-radius:0.5rem;box-shadow:0 10px 40px rgba(0,0,0,0.4);color:hsl(var(--foreground));font-size:0.9375rem;opacity:0;transition:transform 0.3s ease, opacity 0.3s ease;');
    toast.innerHTML = isError ? ('<span>' + (msg || 'Unable to add. Try again.') + '</span>') : ('<span>Added to cart</span> <a href="' + cartUrl + '" style="color:hsl(var(--accent));font-weight:600;margin-left:0.5rem;">View cart</a>');
    document.body.appendChild(toast);
    setTimeout(function() { toast.style.transform = 'translateX(-50%) translateY(0)'; toast.style.opacity = '1'; }, 10);
    setTimeout(function() { toast.style.transform = 'translateX(-50%) translateY(100px)'; toast.style.opacity = '0'; setTimeout(function() { toast.remove(); }, 300); }, 3000);
  }
  forms.forEach(function(form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var btn = form.querySelector('button[type="submit"]');
      var originalText = btn ? btn.textContent : 'Add to cart';
      if (btn) { btn.disabled = true; btn.textContent = 'Adding…'; }
      var formData = new FormData(form);
      fetch(addUrl, { method: 'POST', headers: { 'Accept': 'application/json' }, credentials: 'same-origin', body: formData })
        .then(function(res) { return res.json().then(function(data) { return { ok: res.ok, data: data }; }); })
        .then(function(result) {
          var data = result.data;
          var isError = (data && data.status === 422) || (data && data.message) || !result.ok;
          if (btn) { btn.disabled = false; btn.textContent = originalText; }
          if (isError) {
            var msg = (data && (data.description || data.message)) || 'Unable to add. Try again.';
            showToast(typeof msg === 'string' ? msg : 'Unable to add. Try again.', true);
            return;
          }
          if (btn) btn.textContent = 'Added!';
          showToast('Added to cart', false);
          if (typeof window.updateCartCount === 'function') window.updateCartCount();
          setTimeout(function() { if (btn) btn.textContent = originalText; }, 2000);
        })
        .catch(function() {
          if (btn) { btn.disabled = false; btn.textContent = originalText; }
          showToast('Unable to add. Try again.', true);
        });
    });
  });
})();
</script>
{% endif %}
