{% comment %}
  Final CTA banner - conversion-focused close.
{% endcomment %}

<section class="final-cta-banner py-14 md:py-20">
  <div class="container mx-auto px-6">
    <div class="final-cta-inner">
      <h2 class="final-cta-title">{{ section.settings.heading | default: "Ready to upgrade your wardrobe?" }}</h2>
      <p class="final-cta-sub">{{ section.settings.subheading | default: "Shop premium hoodies, sweatshirts, and graphic tees built for daily style." }}</p>
      <a href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}/collections/all{% endif %}" class="final-cta-btn">
        {{ section.settings.button_text | default: "Shop now" }}
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta-inner {
    border-radius: 1.15rem;
    border: 1px solid hsl(var(--border) / 0.55);
    background: linear-gradient(145deg, hsl(var(--card)), hsl(var(--secondary)));
    padding: 1.5rem 1.25rem;
    text-align: center;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.14);
  }
  @media (min-width: 768px) {
    .final-cta-inner { padding: 2.5rem 2rem; }
  }
  .final-cta-title {
    margin: 0 0 0.45rem;
    color: hsl(var(--foreground));
    font-size: clamp(1.45rem, 3vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  .final-cta-sub {
    margin: 0 auto 1rem;
    color: hsl(var(--foreground) / 0.68);
    max-width: 60ch;
    line-height: 1.5;
    font-size: 0.95rem;
  }
  .final-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    background: hsl(var(--accent));
    color: hsl(var(--accent-foreground));
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .final-cta-btn:hover {
    opacity: 0.93;
    transform: translateY(-1px);
  }
</style>

{% schema %}
{
  "name": "Final CTA banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to upgrade your wardrobe?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Shop premium hoodies, sweatshirts, and graphic tees built for daily style." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "Final CTA banner" }
  ]
}
{% endschema %}
