{% comment %}
  Search results section - used on /search
{% endcomment %}

<section class="py-16 md:py-24 bg-background">
  <div class="container mx-auto px-6">
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-6">
      {% if search.performed %}
        {{ 'general.search.results_with_count' | t: count: search.results_count, terms: search.terms }}
      {% else %}
        {{ 'general.search.title' | t | default: 'Search' }}
      {% endif %}
    </h1>

    <form action="{{ routes.search_url }}" method="get" class="max-w-xl mb-10">
      <div class="flex gap-2">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t | default: 'Search our store' }}" class="flex-1 min-w-0 px-4 py-3 rounded-lg bg-card border border-border text-foreground" aria-label="{{ 'general.search.placeholder' | t }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="px-6 py-3 rounded-lg bg-accent text-background font-medium whitespace-nowrap">
          {{ 'general.search.submit' | t | default: 'Search' }}
        </button>
      </div>
    </form>

    {% if search.performed %}
      {% if search.results_count > 0 %}
        {% paginate search.results by 24 %}
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 product-grid">
            {% for item in search.results %}
              {% case item.object_type %}
                {% when 'product' %}
                  <div class="product-card group relative bg-card rounded-3xl overflow-hidden">
                    <a href="{{ item.url }}" class="block aspect-[4/5] relative overflow-hidden">
                      {% if item.featured_image != blank %}
                        <img src="{{ item.featured_image | image_url: width: 600 }}" alt="{{ item.featured_image.alt | escape }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy">
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
                      {% endif %}
                      <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-background/20 to-transparent"></div>
                    </a>
                    <div class="absolute bottom-0 left-0 right-0 product-card-overlay-inner">
                      <div class="relative z-10">
                        <h3 class="product-card-title font-bold text-foreground">
                          <a href="{{ item.url }}" class="hover:underline">{{ item.title }}</a>
                        </h3>
                        <span class="product-card-price font-medium text-foreground/80">{{ item.price | money }}</span>
                        <a href="{{ item.url }}" class="btn-hero text-xs inline-block mt-2">View</a>
                      </div>
                    </div>
                  </div>
                {% when 'article' %}
                  <div class="bg-card rounded-2xl overflow-hidden border border-border/30">
                    <a href="{{ item.url }}" class="block">
                      {% if item.image != blank %}
                        <img src="{{ item.image | image_url: width: 400 }}" alt="{{ item.image.alt | escape }}" class="w-full aspect-[4/3] object-cover" loading="lazy">
                      {% endif %}
                      <div class="p-4">
                        <h3 class="font-bold text-foreground mb-1">{{ item.title }}</h3>
                        <p class="text-sm text-foreground/60 line-clamp-2">{{ item.content | strip_html | truncate: 80 }}</p>
                      </div>
                    </a>
                  </div>
                {% when 'page' %}
                  <div class="bg-card rounded-2xl p-4 border border-border/30">
                    <a href="{{ item.url }}" class="font-bold text-foreground hover:underline">{{ item.title }}</a>
                    {% if item.content != blank %}<p class="text-sm text-foreground/60 mt-1 line-clamp-2">{{ item.content | strip_html | truncate: 80 }}</p>{% endif %}
                  </div>
              {% endcase %}
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <nav class="mt-12 flex justify-center gap-2 flex-wrap" aria-label="Pagination">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" class="px-4 py-2 rounded-lg border border-border text-foreground hover:bg-card">{{ 'general.pagination.previous' | t | default: 'Previous' }}</a>
              {% endif %}
              <span class="px-4 py-2 text-foreground/70">{{ 'general.pagination.current_page' | t: current: paginate.current_page, total: paginate.pages | default: 'Page current of total' }}</span>
              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" class="px-4 py-2 rounded-lg border border-border text-foreground hover:bg-card">{{ 'general.pagination.next' | t | default: 'Next' }}</a>
              {% endif %}
            </nav>
          {% endif %}
        {% endpaginate %}
      {% else %}
        <p class="text-lg text-foreground/70">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {% endif %}
    {% endif %}
  </div>
</section>
