{% comment %}
  Product page – Amazon-style clean white layout: gallery left, details right.
{% endcomment %}

<div class="amazon-product-wrapper">
  <div class="amazon-product-inner">
    <div class="amazon-product-gallery product-gallery">
      {% if product.featured_image != blank %}
        <img
          src="{{ product.featured_image | image_url: width: 800 }}"
          alt="{{ product.featured_image.alt | escape }}"
          class="amazon-product-main-img"
          id="ProductPhotoImg"
          loading="eager"
        >
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'amazon-product-main-img' }}
      {% endif %}
      {% if product.images.size > 1 %}
        <div class="amazon-product-thumbs thumbnail-list">
          {% for image in product.images %}
            <button type="button" class="amazon-product-thumb flex-shrink-0 w-20 h-20 rounded overflow-hidden border border-gray-200 {% if forloop.first %}thumbnail-active{% endif %}" data-index="{{ forloop.index0 }}" data-src="{{ image | image_url: width: 800 }}" aria-label="View image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 100 }}" alt="{{ image.alt | escape }}" class="w-full h-full object-cover" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="amazon-product-details product-detail">
      {% if product.vendor != blank %}
        <p class="amazon-product-vendor">{{ product.vendor }}</p>
      {% endif %}
      <h1 class="amazon-product-title">{{ product.title }}</h1>

      <div class="amazon-product-rating" aria-hidden="true">
        <span class="amazon-product-stars">★★★★★</span>
        <span class="amazon-product-rating-label">Rating</span>
      </div>

      <div class="amazon-product-price" data-product-price>
        {{ product.selected_or_first_available_variant.price | money }}
      </div>
      {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
        <div class="amazon-product-compare">
          <span class="line-through text-gray-500">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
          <span class="amazon-product-save">Save {{ product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | money }}</span>
        </div>
      {% endif %}

      <form action="{{ routes.cart_add_url }}" method="post" id="product-form" class="product-form amazon-product-form" data-option-names='{{ product.options_with_values | map: "name" | json }}'>
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

        {% unless product.has_only_default_variant %}
          <div class="amazon-product-options space-y-4 mb-6">
            {% for option in product.options_with_values %}
              <div>
                <label for="Option-{{ section.id }}-{{ forloop.index0 }}" class="amazon-product-option-label">{{ option.name }}</label>
                <div class="flex flex-wrap gap-2 option-values" data-option-index="{{ forloop.index0 }}">
                  {% for value in option.values %}
                    <label class="relative cursor-pointer option-value-label">
                      <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" class="sr-only option-radio" data-option-index="{{ forloop.parentloop.index0 }}" {% if option.selected_value == value %}checked{% endif %}>
                      <span class="block px-4 py-2 rounded border border-gray-300 bg-white text-gray-900 hover:border-amber-400 transition-colors option-value-span">{{ value }}</span>
                    </label>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endunless %}

        <div class="amazon-product-actions flex flex-wrap items-center gap-4 mb-6">
          <div class="flex items-center border border-gray-300 rounded overflow-hidden bg-white">
            <label for="Quantity-{{ section.id }}" class="visually-hidden">{{ 'products.product.quantity' | t | default: 'Quantity' }}</label>
            <button type="button" class="quantity-btn px-4 py-3 text-gray-700 hover:bg-gray-100 transition-colors" aria-label="Decrease quantity" data-quantity-minus>-</button>
            <input type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" max="99" class="w-14 text-center py-3 bg-transparent text-gray-900 border-x border-gray-300 focus:outline-none focus:ring-0" data-quantity-input>
            <button type="button" class="quantity-btn px-4 py-3 text-gray-700 hover:bg-gray-100 transition-colors" aria-label="Increase quantity" data-quantity-plus>+</button>
          </div>
          <button type="submit" name="add" class="product-form__submit flex-1 min-w-[200px] py-3 px-6 rounded font-semibold transition-opacity disabled:opacity-50 disabled:cursor-not-allowed" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %} data-add-to-cart>
            {% if product.selected_or_first_available_variant.available %}
              {{ 'products.product.add_to_cart' | t }}
            {% else %}
              {{ 'products.product.sold_out' | t }}
            {% endif %}
          </button>
        </div>
      </form>

      {% if product.description != blank %}
        <div class="amazon-product-description">
          {{ product.description }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
(function() {
  var form = document.getElementById('product-form');
  if (!form) return;
  var variantIdInput = form.querySelector('[data-variant-id]');
  var addToCartBtn = form.querySelector('[data-add-to-cart]');
  var priceEl = document.querySelector('[data-product-price]');
  var variantData = {{ product.variants | json }};
  var variantPrices = {};
  {% for v in product.variants %}
  variantPrices[{{ v.id }}] = {{ v.price | money | json }};
  {% endfor %}
  var optionNames = [];
  try { optionNames = JSON.parse(form.getAttribute('data-option-names') || '[]'); } catch (e) {}
  var optionRadios = form.querySelectorAll('.option-radio');

  function getSelectedOptionsArray() {
    var arr = [];
    for (var i = 0; i < optionNames.length; i++) {
      var name = 'options[' + optionNames[i] + ']';
      var radio = form.querySelector('.option-radio[name="' + name + '"]:checked');
      arr.push(radio ? radio.value : null);
    }
    return arr;
  }
  function findVariant() {
    var selected = getSelectedOptionsArray();
    for (var i = 0; i < variantData.length; i++) {
      var v = variantData[i];
      var match = true;
      if (v.options) {
        for (var j = 0; j < v.options.length; j++) {
          if (selected[j] !== undefined && selected[j] !== v.options[j]) { match = false; break; }
        }
      }
      if (match) return v;
    }
    return variantData[0];
  }
  function setActiveOptionStyles() {
    form.querySelectorAll('.option-value-span').forEach(function(span) {
      span.classList.remove('!border-accent', 'ring-2', 'ring-accent/30');
    });
    form.querySelectorAll('.option-radio:checked').forEach(function(radio) {
      var span = radio.closest('.option-value-label').querySelector('.option-value-span');
      if (span) span.classList.add('!border-accent', 'ring-2', 'ring-accent/30');
    });
  }
  function updateForm(variant) {
    if (!variant) return;
    if (variantIdInput) variantIdInput.value = variant.id;
    if (priceEl && variantPrices[variant.id]) priceEl.textContent = variantPrices[variant.id];
    if (addToCartBtn) {
      addToCartBtn.disabled = !variant.available;
      addToCartBtn.textContent = variant.available ? (window.variantStrings && window.variantStrings.addToCart ? window.variantStrings.addToCart : 'Add to cart') : (window.variantStrings && window.variantStrings.soldOut ? window.variantStrings.soldOut : 'Sold out');
    }
    setActiveOptionStyles();
  }
  setActiveOptionStyles();
  form.addEventListener('submit', function(e) {
    var submitter = e.submitter || document.activeElement;
    var isAddButton = false;
    if (submitter) {
      if ((submitter.matches && submitter.matches('[data-add-to-cart], .product-form__submit')) || submitter.name === 'add') {
        isAddButton = true;
      }
    }
    // Let non Add to Cart submits (for example, dynamic checkout) behave normally.
    if (!isAddButton) {
      return;
    }

    e.preventDefault();
    if (form.dataset.processing === 'true') {
      return;
    }
    form.dataset.processing = 'true';
    if (addToCartBtn) addToCartBtn.disabled = true;

    var cartAddUrl = (window.routes && window.routes.cart_add_url) || form.getAttribute('action') || '/cart/add';
    var addUrl = cartAddUrl.replace(/\/add\/?(\?.*)?$/i, '') + '/add.js';
    var formData = new FormData(form);

    fetch(addUrl, {
      method: 'POST',
      body: formData,
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json' }
    })
    .then(function(res) {
      return res.json().then(function(data) {
        return { ok: res.ok, data: data };
      });
    })
    .then(function(result) {
      if (result.ok) {
        if (typeof window.updateCartCount === 'function') window.updateCartCount();
      } else {
        console.error('Add to cart error', result.data);
      }
    })
    .catch(function(err) {
      console.error('Add to cart failed', err);
    })
    .finally(function() {
      form.dataset.processing = 'false';
      if (addToCartBtn) addToCartBtn.disabled = false;
    });
  });
  optionRadios.forEach(function(radio) {
    radio.addEventListener('change', function() { updateForm(findVariant()); });
  });
  form.querySelectorAll('[data-quantity-minus]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var inp = form.querySelector('[data-quantity-input]');
      if (inp) { var n = parseInt(inp.value, 10) || 1; inp.value = Math.max(1, n - 1); }
    });
  });
  form.querySelectorAll('[data-quantity-plus]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var inp = form.querySelector('[data-quantity-input]');
      if (inp) { var n = parseInt(inp.value, 10) || 1; inp.value = Math.min(99, n + 1); }
    });
  });

  var mainImg = document.getElementById('ProductPhotoImg');
  var thumbs = document.querySelectorAll('.amazon-product-thumb');
  thumbs.forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      var src = this.getAttribute('data-src');
      if (mainImg && src) {
        mainImg.src = src;
        mainImg.alt = this.querySelector('img') ? this.querySelector('img').getAttribute('alt') || '' : '';
      }
      thumbs.forEach(function(t) { t.classList.remove('thumbnail-active'); });
      this.classList.add('thumbnail-active');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
