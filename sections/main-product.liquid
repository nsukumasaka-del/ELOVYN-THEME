{% comment %}
  Product page section - product detail with add to cart
{% endcomment %}

<section class="py-16 md:py-24 bg-background">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <div class="product-gallery">
        {% if product.featured_image != blank %}
          <img
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | escape }}"
            class="w-full rounded-2xl border border-border/30"
            id="ProductPhotoImg"
            loading="eager"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'w-full rounded-2xl border border-border/30' }}
        {% endif %}
        {% if product.images.size > 1 %}
          <div class="flex gap-2 mt-4 overflow-x-auto">
            {% for image in product.images %}
              <button type="button" class="flex-shrink-0 w-20 h-20 rounded-lg overflow-hidden border border-border/30 {% if forloop.first %}ring-2 ring-accent{% endif %}" data-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 100 }}" alt="{{ image.alt | escape }}" class="w-full h-full object-cover" loading="lazy">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="product-detail">
        <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-2">{{ product.title }}</h1>
        {% if product.vendor != blank %}
          <p class="text-foreground/60 mb-4">{{ product.vendor }}</p>
        {% endif %}
        <div class="text-2xl font-semibold text-foreground mb-6">
          {{ product.price | money }}
          {% if product.compare_at_price > product.price %}
            <span class="text-lg text-foreground/60 line-through ml-2">{{ product.compare_at_price | money }}</span>
            <span class="text-accent text-base ml-2">{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}% off</span>
          {% endif %}
        </div>

        {% form 'product', product, id: 'product-form', class: 'product-form' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
          {% unless product.has_only_default_variant %}
            <div class="mb-6">
              {% for option in product.options_with_values %}
                <label class="block text-sm font-medium text-foreground mb-2">{{ option.name }}</label>
                <div class="flex flex-wrap gap-2">
                  {% for value in option.values %}
                    <label class="inline-flex items-center">
                      <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} class="mr-2">
                      <span class="text-foreground">{{ value }}</span>
                    </label>
                  {% endfor %}
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <div class="flex flex-wrap items-center gap-4 mb-6">
            <label for="Quantity" class="text-sm font-medium text-foreground">{{ 'products.product.quantity' | t | default: 'Quantity' }}</label>
            <input type="number" id="Quantity" name="quantity" value="1" min="1" max="99" class="w-20 px-3 py-2 rounded-lg border border-border bg-card text-foreground">
            <button type="submit" name="add" class="px-8 py-3 rounded-lg bg-accent text-background font-semibold hover:opacity-90 transition-opacity disabled:opacity-50" {% unless product.available %}disabled{% endunless %}>
              {% if product.available %}
                {{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}
              {% else %}
                {{ 'products.product.sold_out' | t | default: 'Sold out' }}
              {% endif %}
            </button>
          </div>
        {% endform %}

        {% if product.description != blank %}
          <div class="prose prose-invert max-w-none text-foreground/80 mt-8 border-t border-border/30 pt-8">
            {{ product.description }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var thumbs = document.querySelectorAll('.product-gallery button[data-index]');
    var mainImg = document.getElementById('ProductPhotoImg');
    if (mainImg && thumbs.length) {
      var imgs = document.querySelectorAll('.product-gallery .product-gallery img, .product-gallery button[data-index] img');
      thumbs.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var idx = parseInt(btn.getAttribute('data-index'), 10);
          var imgEl = btn.querySelector('img');
          if (imgEl && imgEl.src) {
            mainImg.src = imgEl.src.replace(/_\d+x\d+/, '_800x');
          }
          thumbs.forEach(function(t) { t.classList.remove('ring-2', 'ring-accent'); });
          btn.classList.add('ring-2', 'ring-accent');
        });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
