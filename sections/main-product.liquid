{% comment %}
  Product page section - product detail with add to cart
{% endcomment %}

<section class="py-16 md:py-24 bg-background">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <div class="product-gallery">
        {% if product.featured_image != blank %}
          <img
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | escape }}"
            class="w-full rounded-2xl border border-border/30"
            id="ProductPhotoImg"
            loading="eager"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'w-full rounded-2xl border border-border/30' }}
        {% endif %}
        {% if product.images.size > 1 %}
          <div class="flex gap-2 mt-4 overflow-x-auto">
            {% for image in product.images %}
              <button type="button" class="flex-shrink-0 w-20 h-20 rounded-lg overflow-hidden border border-border/30 {% if forloop.first %}ring-2 ring-accent{% endif %}" data-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 100 }}" alt="{{ image.alt | escape }}" class="w-full h-full object-cover" loading="lazy">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="product-detail">
        {%- assign view_url = product.url -%}
        {%- assign title_lower = product.title | downcase -%}
        {%- if title_lower contains "athletic fit tee" or title_lower contains "athletic fit tees" -%}
          {%- assign view_url = "https://amzn.to/45I1l6l" -%}
        {%- elsif title_lower contains "coofandy" and title_lower contains "short" and title_lower contains "button" -%}
          {%- assign view_url = "https://amzn.to/4komatB" -%}
        {%- elsif title_lower contains "soly hux" and title_lower contains "textured" -%}
          {%- assign view_url = "https://amzn.to/3NUPlbB" -%}
        {%- endif -%}

        <span class="text-xs font-semibold uppercase tracking-wider text-foreground/60">{{ 'general.amazon.sponsored' | t | default: 'Sponsored' }}</span>
        <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-2 mt-1">{{ product.title }}</h1>
        {% if product.vendor != blank %}
          <p class="text-foreground/60 mb-4">{{ product.vendor }}</p>
        {% endif %}

        {% render 'amazon-disclosure' %}

        <div class="flex flex-wrap items-center gap-4 mb-6">
          <a href="{{ view_url }}" class="px-8 py-3 rounded-lg bg-accent text-background font-semibold hover:opacity-90 transition-opacity inline-flex items-center gap-2" target="_blank" rel="noopener noreferrer{% if view_url contains 'amzn.to' %} sponsored{% endif %}">
            {% if view_url contains 'amzn.to' %}{{ 'general.amazon.view_on_amazon' | t | default: 'View on Amazon' }}{% else %}{{ 'general.amazon.view_product' | t | default: 'View product' }}{% endif %}
          </a>
          {% if view_url contains 'amzn.to' %}<p class="text-sm text-foreground/60">{{ 'general.amazon.check_price' | t | default: 'Price and availability at Amazon.' }}</p>{% endif %}
        </div>

        {% if product.description != blank %}
          <div class="prose prose-invert max-w-none text-foreground/80 mt-8 border-t border-border/30 pt-8">
            {{ product.description }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var thumbs = document.querySelectorAll('.product-gallery button[data-index]');
    var mainImg = document.getElementById('ProductPhotoImg');
    if (mainImg && thumbs.length) {
      var imgs = document.querySelectorAll('.product-gallery .product-gallery img, .product-gallery button[data-index] img');
      thumbs.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var idx = parseInt(btn.getAttribute('data-index'), 10);
          var imgEl = btn.querySelector('img');
          if (imgEl && imgEl.src) {
            mainImg.src = imgEl.src.replace(/_\d+x\d+/, '_800x');
          }
          thumbs.forEach(function(t) { t.classList.remove('ring-2', 'ring-accent'); });
          btn.classList.add('ring-2', 'ring-accent');
        });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
