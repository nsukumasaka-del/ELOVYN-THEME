{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "Enable sticky Add to Cart on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky_buy_column",
      "label": "Sticky product details on desktop",
      "default": true,
      "info": "Keeps title, price, and form visible while scrolling on large screens."
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable image zoom (lightbox)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_size_guide",
      "label": "Show size guide link (when a Size option exists)",
      "default": true
    },
    {
      "type": "text",
      "id": "size_guide_button_label",
      "label": "Size guide button label",
      "default": "Size guide"
    },
    {
      "type": "text",
      "id": "size_guide_modal_title",
      "label": "Size guide modal title",
      "default": "Size guide"
    },
    {
      "type": "richtext",
      "id": "size_guide_content",
      "label": "Size guide content"
    },
    {
      "type": "checkbox",
      "id": "show_low_stock",
      "label": "Show low stock message",
      "default": true
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low stock threshold (units)",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "low_stock_message",
      "label": "Low stock message",
      "default": "Only [qty] left — order soon.",
      "info": "Use [qty] for the remaining quantity."
    }
  ],
  "blocks": [
    {
      "type": "feature_bullet",
      "name": "Feature bullet",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Premium quality"
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
