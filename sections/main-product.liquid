{% comment %}
  Product page – price, variant selector, Add to cart (ready for sales).
{% endcomment %}

<section class="py-16 md:py-24 bg-background">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
      <div class="product-gallery">
        {% if product.featured_image != blank %}
          <img
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | escape }}"
            class="w-full rounded-2xl border border-border/30"
            id="ProductPhotoImg"
            loading="eager"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'w-full rounded-2xl border border-border/30' }}
        {% endif %}
        {% if product.images.size > 1 %}
          <div class="flex gap-2 mt-4 overflow-x-auto">
            {% for image in product.images %}
              <button type="button" class="flex-shrink-0 w-20 h-20 rounded-lg overflow-hidden border border-border/30 {% if forloop.first %}ring-2 ring-accent{% endif %}" data-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 100 }}" alt="{{ image.alt | escape }}" class="w-full h-full object-cover" loading="lazy">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="product-detail">
        {% if product.vendor != blank %}
          <p class="text-sm font-medium text-accent uppercase tracking-wider mb-2">{{ product.vendor }}</p>
        {% endif %}
        <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-4">{{ product.title }}</h1>

        <div class="flex items-center gap-3 mb-6 flex-wrap">
          <span class="text-2xl font-bold text-foreground" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</span>
          {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
            <span class="text-lg text-foreground/50 line-through">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
            <span class="text-sm font-medium text-accent bg-accent/20 px-2 py-1 rounded">Save {{ product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | money }}</span>
          {% endif %}
        </div>

        <form action="{{ routes.cart_add_url }}" method="post" id="product-form" class="product-form" data-option-names='{{ product.options_with_values | map: "name" | json }}'>
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

          {% unless product.has_only_default_variant %}
            <div class="space-y-4 mb-6">
              {% for option in product.options_with_values %}
                <div>
                  <label for="Option-{{ section.id }}-{{ forloop.index0 }}" class="block text-sm font-semibold text-foreground mb-2">{{ option.name }}</label>
                  <div class="flex flex-wrap gap-2 option-values" data-option-index="{{ forloop.index0 }}">
                    {% for value in option.values %}
                      <label class="relative cursor-pointer option-value-label">
                        <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" class="sr-only option-radio" data-option-index="{{ forloop.parentloop.index0 }}" {% if option.selected_value == value %}checked{% endif %}>
                        <span class="block px-4 py-2 rounded-xl border-2 border-border bg-card text-foreground hover:border-foreground/30 transition-colors option-value-span">{{ value }}</span>
                      </label>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endunless %}

          <div class="flex flex-wrap items-center gap-4 mb-6">
            <div class="flex items-center border border-border rounded-xl overflow-hidden bg-card">
              <label for="Quantity-{{ section.id }}" class="visually-hidden">{{ 'products.product.quantity' | t | default: 'Quantity' }}</label>
              <button type="button" class="quantity-btn px-4 py-3 text-foreground hover:bg-secondary transition-colors" aria-label="Decrease quantity" data-quantity-minus>-</button>
              <input type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" max="99" class="w-14 text-center py-3 bg-transparent text-foreground border-x border-border focus:outline-none focus:ring-0" data-quantity-input>
              <button type="button" class="quantity-btn px-4 py-3 text-foreground hover:bg-secondary transition-colors" aria-label="Increase quantity" data-quantity-plus>+</button>
            </div>
            <button type="submit" name="add" class="flex-1 min-w-[200px] py-3 px-6 rounded-xl bg-accent text-accent-foreground font-semibold hover:opacity-90 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %} data-add-to-cart>
              {% if product.selected_or_first_available_variant.available %}
                {{ 'products.product.add_to_cart' | t }}
              {% else %}
                {{ 'products.product.sold_out' | t }}
              {% endif %}
            </button>
          </div>
        </form>

        {% if product.description != blank %}
          <div class="prose prose-invert max-w-none text-foreground/80 mt-8 border-t border-border/30 pt-8">
            {{ product.description }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  var form = document.getElementById('product-form');
  if (!form) return;
  var variantIdInput = form.querySelector('[data-variant-id]');
  var addToCartBtn = form.querySelector('[data-add-to-cart]');
  var priceEl = document.querySelector('[data-product-price]');
  var variantData = {{ product.variants | json }};
  var variantPrices = {};
  {% for v in product.variants %}
  variantPrices[{{ v.id }}] = {{ v.price | money | json }};
  {% endfor %}
  var optionNames = [];
  try { optionNames = JSON.parse(form.getAttribute('data-option-names') || '[]'); } catch (e) {}
  var optionRadios = form.querySelectorAll('.option-radio');

  function getSelectedOptionsArray() {
    var arr = [];
    for (var i = 0; i < optionNames.length; i++) {
      var name = 'options[' + optionNames[i] + ']';
      var radio = form.querySelector('.option-radio[name="' + name + '"]:checked');
      arr.push(radio ? radio.value : null);
    }
    return arr;
  }
  function findVariant() {
    var selected = getSelectedOptionsArray();
    for (var i = 0; i < variantData.length; i++) {
      var v = variantData[i];
      var match = true;
      if (v.options) {
        for (var j = 0; j < v.options.length; j++) {
          if (selected[j] !== undefined && selected[j] !== v.options[j]) { match = false; break; }
        }
      }
      if (match) return v;
    }
    return variantData[0];
  }
  function setActiveOptionStyles() {
    form.querySelectorAll('.option-value-span').forEach(function(span) {
      span.classList.remove('!border-accent', 'ring-2', 'ring-accent/30');
    });
    form.querySelectorAll('.option-radio:checked').forEach(function(radio) {
      var span = radio.closest('.option-value-label').querySelector('.option-value-span');
      if (span) span.classList.add('!border-accent', 'ring-2', 'ring-accent/30');
    });
  }
  function updateForm(variant) {
    if (!variant) return;
    if (variantIdInput) variantIdInput.value = variant.id;
    if (priceEl && variantPrices[variant.id]) priceEl.textContent = variantPrices[variant.id];
    if (addToCartBtn) {
      addToCartBtn.disabled = !variant.available;
      addToCartBtn.textContent = variant.available ? (window.variantStrings && window.variantStrings.addToCart ? window.variantStrings.addToCart : 'Add to cart') : (window.variantStrings && window.variantStrings.soldOut ? window.variantStrings.soldOut : 'Sold out');
    }
    setActiveOptionStyles();
  }
  setActiveOptionStyles();
  optionRadios.forEach(function(radio) {
    radio.addEventListener('change', function() { updateForm(findVariant()); });
  });
  form.querySelectorAll('[data-quantity-minus]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var inp = form.querySelector('[data-quantity-input]');
      if (inp) { var n = parseInt(inp.value, 10) || 1; inp.value = Math.max(1, n - 1); }
    });
  });
  form.querySelectorAll('[data-quantity-plus]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var inp = form.querySelector('[data-quantity-input]');
      if (inp) { var n = parseInt(inp.value, 10) || 1; inp.value = Math.min(99, n + 1); }
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
