{% comment %}
  Cart page section
{% endcomment %}

<section class="py-16 md:py-24 bg-background">
  <div class="container mx-auto px-6">
    <h1 class="text-3xl md:text-4xl font-bold text-foreground mb-8">{{ 'sections.cart.title' | t | default: 'Your cart' }}</h1>

    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" id="cart-form">
        <div class="max-w-4xl">
          <ul class="divide-y divide-border/50">
            {% for item in cart.items %}
              <li class="py-6 flex flex-col sm:flex-row gap-4 items-start sm:items-center">
                <a href="{{ item.url }}" class="flex-shrink-0 w-24 h-24 rounded-lg overflow-hidden border border-border/30">
                  {% if item.image != blank %}
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" class="w-full h-full object-cover" loading="lazy">
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
                  {% endif %}
                </a>
                <div class="flex-1 min-w-0">
                  <a href="{{ item.url }}" class="font-semibold text-foreground hover:underline">{{ item.product.title }}</a>
                  {% unless item.product.has_only_default_variant %}
                    <p class="text-sm text-foreground/60 mt-1">{{ item.variant.title }}</p>
                  {% endunless %}
                  <p class="text-foreground/80 mt-1">{{ item.final_line_price | money }}</p>
                </div>
                <div class="flex items-center gap-2">
                  <label for="updates_{{ item.key }}" class="visually-hidden">Quantity for {{ item.product.title }}</label>
                  <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" max="99" class="w-16 px-2 py-2 rounded border border-border bg-card text-foreground text-center">
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&amp;quantity=0" class="text-sm text-foreground/60 hover:text-foreground">{{ 'sections.cart.remove' | t | default: 'Remove' }}</a>
                </div>
              </li>
            {% endfor %}
          </ul>

          <div class="mt-8 pt-8 border-t border-border/50 flex flex-col sm:flex-row justify-between gap-6">
            <div class="flex gap-4">
              <button type="submit" name="update" class="px-6 py-3 rounded-lg border border-border text-foreground hover:bg-card">{{ 'sections.cart.update' | t | default: 'Update cart' }}</button>
              <a href="{{ routes.all_products_collection_url }}" class="px-6 py-3 rounded-lg border border-border text-foreground hover:bg-card inline-flex items-center">{{ 'sections.cart.continue_shopping' | t | default: 'Continue shopping' }}</a>
            </div>
            <div class="text-right">
              <p class="text-lg font-semibold text-foreground mb-2">{{ 'sections.cart.subtotal' | t | default: 'Subtotal' }}: {{ cart.total_price | money }}</p>
              <button type="submit" name="checkout" class="px-8 py-3 rounded-lg bg-accent text-background font-semibold hover:opacity-90 transition-opacity w-full sm:w-auto">
                {{ 'sections.cart.checkout' | t | default: 'Check out' }}
              </button>
            </div>
          </div>
        </div>
      </form>
    {% else %}
      <p class="text-lg text-foreground/70 mb-6">{{ 'sections.cart.empty' | t | default: 'Your cart is empty.' }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="inline-flex px-6 py-3 rounded-lg bg-accent text-background font-semibold hover:opacity-90">{{ 'sections.cart.continue_shopping' | t | default: 'Continue shopping' }}</a>
    {% endif %}
  </div>
</section>
