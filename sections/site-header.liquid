{% comment %}
  Site header - Logo + Navigation bar (same as header.liquid).
  Rendered via {% section 'site-header' %} in layout so it always shows (Shopify reserves 'header' for section groups).
{% endcomment %}
<style>
  /* Header: visible on both desktop and mobile/cellphone */
  #elovyn-header-wrap {
    display: block !important;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: transparent;
    transition: background 0.5s, backdrop-filter 0.5s, border 0.5s;
    -webkit-tap-highlight-color: transparent;
  }
  #elovyn-header-wrap.scrolled {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  }
  /* Product page: black header, white text & icons (same as cart) */
  body.template-product #elovyn-header-wrap {
    background-color: #000000 !important;
    background: #000000 !important;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }
  body.template-product #elovyn-header-wrap.scrolled {
    background-color: #000000 !important;
    background: #000000 !important;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }
  body.template-product #elovyn-header-wrap .elovyn-nav a,
  body.template-product #elovyn-header-wrap .elovyn-header-right a,
  body.template-product #elovyn-header-wrap .elovyn-header-right button,
  body.template-product #elovyn-header-wrap .elovyn-logo-link {
    color: #ffffff !important;
  }
  body.template-product #elovyn-header-wrap svg,
  body.template-product #elovyn-header-wrap .icon {
    fill: #ffffff !important;
    color: #ffffff !important;
  }
  body.template-product #elovyn-header-wrap .elovyn-logo-img {
    filter: brightness(1.1);
  }
  #elovyn-header-wrap .elovyn-header-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    gap: 0.5rem;
  }
  @media (min-width: 768px) {
    #elovyn-header-wrap .elovyn-header-inner {
      height: 5rem;
      padding: 0 1.5rem;
      gap: 1rem;
    }
  }
  /* Logo: smaller on mobile, full size on desktop */
  #elovyn-header-wrap .elovyn-logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
    flex-shrink: 0;
    min-height: 44px;
    min-width: 44px;
  }
  @media (min-width: 768px) {
    #elovyn-header-wrap .elovyn-logo-link { font-size: 1.25rem; }
  }
  #elovyn-header-wrap .elovyn-logo-img {
    height: auto;
    max-height: 3rem;
    width: auto;
    display: block;
    object-fit: contain;
  }
  @media (min-width: 768px) {
    #elovyn-header-wrap .elovyn-logo-img {
      max-height: 5rem;
    }
  }
  @media (min-width: 1024px) {
    #elovyn-header-wrap .elovyn-logo-img {
      max-height: 8rem;
    }
  }
  @media (max-width: 768px) {
    #elovyn-header-wrap .elovyn-logo-img {
      width: calc({{ section.settings.logo_width | default: 150 }}px * 0.7);
    }
  }
  /* Desktop nav bar - visible from 1024px, horizontal row */
  #elovyn-header-wrap .elovyn-nav {
    display: none;
    align-items: center;
    flex: 1;
    justify-content: center;
    max-width: 600px;
  }
  @media (min-width: 1024px) {
    #elovyn-header-wrap .elovyn-nav {
      display: flex !important;
    }
  }
  /* Horizontal navigation list */
  #elovyn-header-wrap .site-nav .nav-list,
  #elovyn-header-wrap .elovyn-nav .nav-list {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 30px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  #elovyn-header-wrap .site-nav .nav-item,
  #elovyn-header-wrap .elovyn-nav .nav-item {
    display: inline-block;
  }
  #elovyn-header-wrap .elovyn-nav .nav-link,
  #elovyn-header-wrap .elovyn-nav a {
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color 0.2s;
    white-space: nowrap;
  }
  #elovyn-header-wrap .elovyn-nav .nav-link:hover,
  #elovyn-header-wrap .elovyn-nav a:hover {
    color: #fff;
  }
  #elovyn-header-wrap .site-nav .nav-link {
    color: #ffffff;
    padding: 0 2px;
    font-weight: 500;
  }
  #elovyn-header-wrap .site-nav .nav-link:hover {
    opacity: 0.7;
  }
  /* Mobile: desktop nav list stays horizontal when visible; mobile menu (#elovyn-mobile-menu) stays stacked */
  @media (max-width: 1023px) {
    #elovyn-header-wrap .elovyn-nav .nav-list {
      flex-direction: row;
      gap: 15px;
    }
  }
  /* Right side: icons + CTA + hamburger - visible on all screens */
  #elovyn-header-wrap .elovyn-header-right {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    #elovyn-header-wrap .elovyn-header-right { gap: 0.5rem; }
  }
  @media (min-width: 1024px) {
    #elovyn-header-wrap .elovyn-header-right { gap: 1rem; }
  }
  #elovyn-header-wrap .elovyn-header-right a,
  #elovyn-header-wrap .elovyn-header-right button {
    color: rgba(255, 255, 255, 0.9);
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  @media (min-width: 768px) {
    #elovyn-header-wrap .elovyn-header-right a,
    #elovyn-header-wrap .elovyn-header-right button {
      min-width: 40px;
      min-height: 40px;
    }
  }
  #elovyn-header-wrap .elovyn-header-right a:hover,
  #elovyn-header-wrap .elovyn-header-right a:focus,
  #elovyn-header-wrap .elovyn-header-right button:hover,
  #elovyn-header-wrap .elovyn-header-right button:focus {
    color: #fff;
  }
  /* CTA button - visible on both mobile and desktop */
  #elovyn-header-wrap .elovyn-cta {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.75rem;
    font-size: 0.7rem;
    font-weight: 500;
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 9999px;
    text-decoration: none;
    white-space: nowrap;
    min-height: 40px;
  }
  @media (min-width: 768px) {
    #elovyn-header-wrap .elovyn-cta {
      padding: 0.75rem 1.5rem;
      font-size: 0.75rem;
    }
  }
  #elovyn-header-wrap .elovyn-cta:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.6);
    color: #fff;
  }
  /* Hamburger - visible on mobile/tablet, hidden on desktop */
  #elovyn-header-wrap .elovyn-mobile-btn {
    position: relative;
    z-index: 100001;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
  }
  @media (min-width: 1024px) {
    #elovyn-header-wrap .elovyn-mobile-btn { display: none !important; }
  }
  #elovyn-header-wrap .elovyn-mobile-btn .icon-close {
    display: none;
  }
  #elovyn-header-wrap .elovyn-mobile-btn.active .icon-open { display: none; }
  #elovyn-header-wrap .elovyn-mobile-btn.active .icon-close { display: block !important; }
  /* Mobile menu – fixed overlay above all content; higher z-index so it works on product/collection/cart */
  #elovyn-mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    inset: 0;
    z-index: 100000;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    transition: visibility 0.25s ease, opacity 0.25s ease;
  }
  #elovyn-mobile-menu.open {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
  }
  #elovyn-mobile-menu .elovyn-mobile-menu-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    cursor: pointer;
  }
  #elovyn-mobile-menu .elovyn-mobile-menu-panel {
    position: relative;
    z-index: 1;
    margin-top: 4rem;
    margin-left: 1rem;
    margin-right: 1rem;
    margin-bottom: 1rem;
    max-height: calc(100vh - 5rem);
    background: #111;
    border-radius: 16px;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.4);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    transform: translateY(-12px);
    transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }
  #elovyn-mobile-menu.open .elovyn-mobile-menu-panel {
    transform: translateY(0);
  }
  #elovyn-mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0.5rem 0;
  }
  #elovyn-mobile-menu .elovyn-mobile-link {
    color: rgba(255, 255, 255, 0.95);
    text-decoration: none;
    font-size: 1.0625rem;
    font-weight: 500;
    padding: 0.875rem 1.25rem;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    border: none;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: background 0.2s ease, color 0.2s ease;
  }
  #elovyn-mobile-menu .elovyn-mobile-link:hover,
  #elovyn-mobile-menu .elovyn-mobile-link:active {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }
  @media (min-width: 375px) {
    #elovyn-mobile-menu .elovyn-mobile-link { font-size: 1.125rem; padding: 1rem 1.25rem; }
  }
  #elovyn-mobile-menu .elovyn-mobile-cta {
    margin: 0.75rem 1rem 0.5rem;
    padding: 0.875rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    background: #fff;
    color: #000;
    border-radius: 12px;
    text-decoration: none;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  #elovyn-mobile-menu .elovyn-mobile-cta:active {
    transform: scale(0.98);
  }
  @media (min-width: 1024px) {
    #elovyn-mobile-menu { display: none !important; }
  }
  #elovyn-header-wrap .elovyn-cart-badge {
    position: absolute;
    top: -0.25rem;
    right: -0.25rem;
    background: #d4a574;
    color: #fff;
    font-size: 0.7rem;
    border-radius: 9999px;
    min-width: 1.25rem;
    height: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.25rem;
  }
  #elovyn-header-wrap .elovyn-cart-badge.elovyn-cart-badge--empty {
    visibility: hidden;
    pointer-events: none;
  }
  /* Search toggle (matches other header icons) */
  #elovyn-header-wrap .header-icons {
    display: flex;
    align-items: center;
    gap: inherit;
  }
  #elovyn-header-wrap .header-search-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: inherit;
  }
  /* Search drawer */
  .search-drawer {
    position: fixed;
    inset: 0;
    display: none;
    z-index: 9999;
    pointer-events: none;
  }
  .search-drawer.active {
    display: block;
    pointer-events: auto;
  }
  .search-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }
  .search-content {
    position: absolute;
    top: 0;
    right: 0;
    width: 400px;
    max-width: 90%;
    height: 100%;
    background: #fff;
    padding: 30px;
    box-shadow: -4px 0 20px rgba(0, 0, 0, 0.15);
  }
  .search-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    color: #111;
    padding: 0.25rem;
  }
  .search-drawer-form {
    margin-top: 2.5rem;
  }
  .search-drawer-form input[type="search"] {
    width: 100%;
    padding: 12px 14px;
    margin-bottom: 15px;
    border: 1px solid #ddd;
    border-radius: 6px;
    font-size: 1rem;
  }
  .search-drawer-form .search-drawer-submit {
    padding: 10px 20px;
    background: #111;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-weight: 500;
    cursor: pointer;
  }
  @media (max-width: 480px) {
    .search-content { width: 100%; max-width: 100%; }
  }
</style>

<div id="elovyn-header-wrap" class="{% if request.page_type == 'product' or request.page_type == 'cart' %}header--black{% elsif request.page_type == 'index' %}header--transparent{% endif %}">
  <header class="elovyn-header site-header" role="banner">
    <div class="elovyn-header-inner">
      {%- comment -%} Logo: section settings first, then Theme settings > General (store logo), then asset {%- endcomment -%}
      {%- assign logo_width = section.settings.logo_width | default: 150 -%}
      {%- assign logo_alt = section.settings.logo_alt | default: settings.header_logo_alt | default: 'Store Logo' -%}
      {%- assign logo_link = section.settings.logo_link | default: settings.header_logo_link | default: routes.root_url -%}
      <a href="{{ logo_link }}" class="elovyn-logo-link">
        {%- if section.settings.logo_image != blank -%}
          <img
            src="{{ section.settings.logo_image | image_url: width: logo_width }}"
            alt="{{ logo_alt }}"
            class="elovyn-logo-img"
            loading="eager"
            style="width: {{ logo_width }}px; height: auto;"
          >
        {%- elsif section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: logo_width }}"
            alt="{{ logo_alt }}"
            class="elovyn-logo-img"
            loading="eager"
            style="width: {{ logo_width }}px; height: auto;"
          >
        {%- elsif settings.header_logo != blank -%}
          <img
            src="{{ settings.header_logo | image_url: width: logo_width }}"
            alt="{{ logo_alt }}"
            class="elovyn-logo-img"
            loading="eager"
            style="width: {{ logo_width }}px; height: auto;"
          >
        {%- else -%}
          <img
            src="{{ 'logo.png' | asset_url }}"
            alt="{{ logo_alt }}"
            class="elovyn-logo-img"
            loading="eager"
            style="width: {{ logo_width }}px; height: auto;"
          >
        {%- endif -%}
      </a>

      {%- comment -%} Navigation bar {%- endcomment -%}
      <nav class="elovyn-nav site-nav" role="navigation" aria-label="Main navigation">
        <ul class="nav-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'nav_link' -%}
              {%- assign link_url = block.settings.url | default: '/' -%}
              <li class="nav-item" {{ block.shopify_attributes }}>
                <a href="{{ link_url }}" class="nav-link">{{ block.settings.text | default: 'Link' }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>

      {%- comment -%} Right: Search, Account, Cart, Menu/X {%- endcomment -%}
      <div class="elovyn-header-right header-icons">
        <button type="button" class="header-search-toggle elovyn-header-right-btn" aria-label="{{ 'general.search.placeholder' | t | default: 'Search' }}">
          {% render 'icon-search', width: 20, height: 20 %}
        </button>
        <a href="{{ routes.account_login_url }}" aria-label="Account">
          {% render 'icon-user', width: 20, height: 20 %}
        </a>
        <a href="{{ routes.cart_url }}" aria-label="Cart" style="position: relative;">
          {% render 'icon-shopping-bag', width: 20, height: 20 %}
          <span class="elovyn-cart-badge{% if cart.item_count == 0 %} elovyn-cart-badge--empty{% endif %}" data-cart-count aria-hidden="{% if cart.item_count == 0 %}true{% else %}false{% endif %}">{{ cart.item_count }}</span>
        </a>
        <button type="button" class="elovyn-mobile-btn" aria-controls="elovyn-mobile-menu" aria-label="Toggle menu" aria-expanded="false">
          <span class="icon-open">{% render 'icon-menu', width: 24, height: 24 %}</span>
          <span class="icon-close">{% render 'icon-x', width: 24, height: 24 %}</span>
        </button>
      </div>
    </div>
  </header>

  {%- comment -%} Mobile menu – backdrop (tap to close) + panel {%- endcomment -%}
  <div id="elovyn-mobile-menu" class="menu-drawer" role="dialog" aria-modal="true" aria-label="Mobile menu" aria-hidden="true">
    <div class="elovyn-mobile-menu-backdrop" aria-hidden="true"></div>
    <div class="elovyn-mobile-menu-panel">
      <nav role="navigation" aria-label="Mobile menu">
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav_link' -%}
            {%- assign link_url = block.settings.url | default: '/' -%}
            <a href="{{ link_url }}" class="elovyn-mobile-link">{{ block.settings.text | default: 'Link' }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>
  </div>

  {%- comment -%} Search drawer (Shopify /search) {%- endcomment -%}
  <div class="search-drawer" id="SearchDrawer" aria-hidden="true">
    <div class="search-overlay" aria-hidden="true"></div>
    <div class="search-content">
      <button type="button" class="search-close" aria-label="{{ 'general.search.close' | t | default: 'Close search' }}">&times;</button>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-drawer-form">
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t | default: 'Search products...' }}" aria-label="{{ 'general.search.placeholder' | t | default: 'Search' }}" autocomplete="off">
        <button type="submit" class="search-drawer-submit">{{ 'general.search.submit' | t | default: 'Search' }}</button>
      </form>
    </div>
  </div>
</div>

<script>
  (function() {
    function initMobileMenu() {
      var wrap = document.getElementById('elovyn-header-wrap');
      var mobileMenu = document.getElementById('elovyn-mobile-menu');
      var mobileBtn = wrap && wrap.querySelector('.elovyn-mobile-btn');
      var backdrop = mobileMenu && mobileMenu.querySelector('.elovyn-mobile-menu-backdrop');
      if (!wrap || !mobileMenu || !mobileBtn) return;
    function openMenu() {
      mobileMenu.classList.add('open');
      mobileBtn.classList.add('active');
      mobileBtn.setAttribute('aria-expanded', 'true');
      mobileMenu.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function closeMenu() {
      mobileMenu.classList.remove('open');
      mobileBtn.classList.remove('active');
      mobileBtn.setAttribute('aria-expanded', 'false');
      mobileMenu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
    function toggleMenu() {
      if (mobileMenu.classList.contains('open')) closeMenu();
      else openMenu();
    }
    mobileBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      toggleMenu();
    }, true);
    if (backdrop) backdrop.addEventListener('click', closeMenu);
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && mobileMenu.classList.contains('open')) closeMenu();
    });
    mobileMenu.querySelectorAll('a.elovyn-mobile-link').forEach(function(a) {
      a.addEventListener('click', function() { closeMenu(); });
    });
    window.addEventListener('scroll', function() {
      wrap.classList.toggle('scrolled', window.pageYOffset > 50);
    });

      /* Search drawer */
      var searchToggle = wrap && wrap.querySelector('.header-search-toggle');
      var searchDrawer = document.getElementById('SearchDrawer');
      var searchClose = searchDrawer && searchDrawer.querySelector('.search-close');
      var searchOverlay = searchDrawer && searchDrawer.querySelector('.search-overlay');
      if (searchToggle && searchDrawer) {
        searchToggle.addEventListener('click', function() {
          searchDrawer.classList.add('active');
          searchDrawer.setAttribute('aria-hidden', 'false');
          var input = searchDrawer.querySelector('input[type="search"]');
          if (input) { input.focus(); }
        });
      }
      if (searchClose) {
        searchClose.addEventListener('click', function() {
          searchDrawer.classList.remove('active');
          searchDrawer.setAttribute('aria-hidden', 'true');
        });
      }
      if (searchOverlay) {
        searchOverlay.addEventListener('click', function() {
          searchDrawer.classList.remove('active');
          searchDrawer.setAttribute('aria-hidden', 'true');
        });
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMobileMenu);
    } else {
      initMobileMenu();
    }
  })();
</script>

{% schema %}
{
  "name": "Site Header",
  "tag": "header",
  "class": "section-header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Shown at 8rem height like the original. Leave blank to show store name."
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image",
      "info": "Optional override for the logo image above."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width (px)",
      "min": 50,
      "max": 300,
      "step": 5,
      "default": 150
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alt text",
      "default": "Store Logo",
      "info": "Alt text for the logo. Defaults to 'Store Logo'."
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link",
      "default": "/",
      "info": "Homepage link for the logo."
    },
    {
      "type": "header",
      "content": "Navigation bar"
    },
    {
      "type": "paragraph",
      "content": "Add and reorder menu links below. Default links: Clothes, Hair Products, Accessories, Connect."
    },
