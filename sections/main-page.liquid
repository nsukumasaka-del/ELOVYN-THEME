{% comment %}
  Page template section - for static pages (About, Contact, etc.)
{% endcomment %}

<section class="py-16 md:py-24 bg-background">
  <div class="container mx-auto px-6 max-w-3xl">
    <h1 class="text-4xl md:text-5xl font-bold text-foreground mb-8">{{ page.title }}</h1>
    <div class="prose prose-invert max-w-none text-foreground/90">
      {{ page.content }}
    </div>
  </div>
</section>
