{% comment %}
  Sponsored picks – Block-based: each product card is a block. Click a card in the theme editor to open its settings in the left sidebar and set the "View product" link (sponsor URL).
{% endcomment %}

<section id="{{ section.settings.section_id | default: 'shop' }}" class="sponsored-picks-section py-24 md:py-32 bg-background" data-sponsored-picks>
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="sponsored-picks-heading text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-4">
        {{ section.settings.heading | default: "Sponsored picks" }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="sponsored-picks-desc text-lg text-foreground/60 max-w-xl mx-auto">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="sponsored-picks-grid grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {% for block in section.blocks %}
          {%- if block.type != 'sponsored_product' -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign product = block.settings.product -%}
          {%- assign card_url = product.url | default: '#' -%}
          {%- assign card_button_text = section.settings.button_text | default: 'View product' -%}
          {%- if block.settings.button_text != blank -%}
            {%- assign card_button_text = block.settings.button_text -%}
          {%- endif -%}
          {%- assign card_open_new_tab = false -%}
          {%- if block.settings.url != blank -%}
            {%- assign card_url = block.settings.url -%}
            {%- assign card_open_new_tab = true -%}
          {%- endif -%}

          <a href="{{ card_url }}" class="sponsored-picks-card group relative bg-card rounded-2xl overflow-hidden border border-border/60 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/10 transition-all duration-300 block"{% if card_open_new_tab %} target="_blank" rel="noopener noreferrer sponsored"{% endif %} {{ block.shopify_attributes }}>
            <span class="sponsored-picks-badge" aria-hidden="true">{{ 'general.amazon.sponsored' | t | default: 'Sponsored' }}</span>
            <span class="sponsored-picks-card-link block aspect-[4/5] relative overflow-hidden">
              {% if product != blank and product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" class="sponsored-picks-img w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" width="300" height="375">
              {% else %}
                <span class="sponsored-picks-placeholder w-full h-full flex items-center justify-center bg-muted/30 text-foreground/50 text-sm">
                  {% if product == blank %}Select product{% else %}{{ 'product-1' | placeholder_svg_tag: 'sponsored-picks-img w-full h-full object-cover' }}{% endif %}
                </span>
              {% endif %}
              <span class="sponsored-picks-card-gradient" aria-hidden="true"></span>
            </span>
            <div class="sponsored-picks-card-content">
              {% if product != blank %}
                {% if product.vendor != blank %}
                  <p class="sponsored-picks-tagline">{{ product.vendor }}</p>
                {% endif %}
                <h3 class="sponsored-picks-title" title="{{ product.title | escape }}">{{ product.title }}</h3>
                {% if product.description != blank %}
                  <p class="sponsored-picks-desc-inner line-clamp-2">{{ product.description | strip_html | truncate: 80 }}</p>
                {% endif %}
              {% else %}
                <p class="sponsored-picks-tagline">Sponsored product</p>
                <h3 class="sponsored-picks-title">Click to choose a product</h3>
                <p class="sponsored-picks-desc-inner">Then set the sponsor link in the sidebar.</p>
              {% endif %}
              <span class="sponsored-picks-cta">{{ card_button_text }}</span>
            </div>
          </a>
        {% endfor %}
      </div>
      {% if section.settings.show_view_all and section.settings.view_all_collection != blank %}
        {%- assign view_all_collection = collections[section.settings.view_all_collection] -%}
        {% if view_all_collection.url != blank %}
          <div class="text-center mt-10">
            <a href="{{ view_all_collection.url }}" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-border text-foreground font-semibold hover:bg-card transition-colors">
              {{ section.settings.view_all_text | default: 'View all' }}
            </a>
          </div>
        {% endif %}
      {% endif %}
    {% else %}
      <div class="text-center py-12 px-6 rounded-2xl border-2 border-dashed border-border text-foreground/60">
        <p class="mb-4">No sponsored products yet.</p>
        <p class="text-sm">Click <strong>Add block</strong> → <strong>Sponsored product</strong> in the left sidebar, then choose a product and set the sponsor link for the "View product" button.</p>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .sponsored-picks-section .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sponsored-picks-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: rgba(0,0,0,0.75);
    color: #fff;
    border-radius: 0.25rem;
  }
  .sponsored-picks-card {
    display: flex;
    flex-direction: column;
  }
  .sponsored-picks-card-link {
    flex-shrink: 0;
  }
  .sponsored-picks-card-gradient {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
    pointer-events: none;
  }
  .sponsored-picks-card-content {
    padding: 1rem 1rem 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .sponsored-picks-tagline {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--accent));
  }
  .sponsored-picks-title {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    color: hsl(var(--foreground));
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sponsored-picks-desc-inner {
    font-size: 0.8125rem;
    color: hsl(var(--foreground) / 0.6);
    margin: 0;
    line-height: 1.4;
  }
  .sponsored-picks-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #fff;
    background: hsl(var(--accent));
    border-radius: 0.5rem;
    transition: opacity 0.2s, transform 0.2s;
  }
  .sponsored-picks-card:hover .sponsored-picks-cta {
    opacity: 0.95;
    transform: translateY(-1px);
  }
  .sponsored-picks-placeholder {
    min-height: 200px;
  }
  .product-card-overlay-inner .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

{% schema %}
{
  "name": "Collection grid (shop)",
  "settings": [
    {
      "type": "header",
      "content": "Sponsored product links"
    },
    {
      "type": "paragraph",
      "content": "Each card is a block. Click a product card in the preview to open its settings in the left sidebar. There you can choose the product and set the sponsor link for the \"View product\" button so customers are redirected to the sponsor's page."
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID (for anchor links)",
      "default": "shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sponsored picks"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Handpicked favorites. Click through for the best deals.",
      "info": "Clear to hide the description."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Default button text",
      "default": "View product",
      "info": "Used when a block's button text is empty."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all link",
      "default": false
    },
    {
      "type": "collection",
      "id": "view_all_collection",
      "label": "View all link collection",
      "info": "Optional. Where the View all button goes."
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all button text",
      "default": "View all"
    }
  ],
  "blocks": [
    {
      "type": "sponsored_product",
      "name": "Sponsored product",
      "limit": 24,
      "settings": [
        {
          "type": "header",
          "content": "Product (click the card to edit)"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "The product shown on this card."
        },
        {
          "type": "header",
          "content": "View product button link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Sponsor product link",
          "info": "Where the \"View product\" button sends customers (e.g. sponsor's or affiliate page). Leave empty to use this product's store page."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text (optional)",
          "placeholder": "View product",
          "info": "Override the button label (e.g. \"View on partner site\", \"Shop now\")."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection grid (shop)",
      "blocks": [
        { "type": "sponsored_product" },
        { "type": "sponsored_product" },
        { "type": "sponsored_product" },
        { "type": "sponsored_product" }
      ]
    }
  ]
}
{% endschema %}
