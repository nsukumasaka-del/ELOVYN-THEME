{% comment %}
  Sponsored picks – Products from a collection. Add "Product link" blocks to set the sponsor URL per product.
  Click a product card in the theme editor to open that product's link settings in the left sidebar.
{% endcomment %}

<section id="{{ section.settings.section_id | default: 'shop' }}" class="sponsored-picks-section py-24 md:py-32 bg-background" data-sponsored-picks>
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="sponsored-picks-heading text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-4">
        {{ section.settings.heading | default: "Sponsored picks" }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="sponsored-picks-desc text-lg text-foreground/60 max-w-xl mx-auto">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    {%- assign collection = nil -%}
    {%- if section.settings.collection != blank -%}
      {%- assign collection = collections[section.settings.collection] -%}
    {%- endif -%}
    {%- if collection == nil and collections['frontpage'] != blank -%}
      {%- assign collection = collections['frontpage'] -%}
    {%- endif -%}

    {% if collection != blank and collection.products.size > 0 %}
      <div class="sponsored-picks-grid grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {% for product in collection.products limit: section.settings.products_to_show %}
          {%- assign product_index = forloop.index0 -%}
          {%- assign link_block = nil -%}
          {%- assign link_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'product_link' -%}
              {%- if link_count == product_index -%}
                {%- assign link_block = block -%}
                {%- break -%}
              {%- endif -%}
              {%- assign link_count = link_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign card_url = product.url -%}
          {%- assign card_button_text = section.settings.button_text | default: 'View on Amazon' -%}
          {%- assign card_open_new_tab = false -%}
          {%- if link_block != nil -%}
            {%- if link_block.settings.url != blank -%}
              {%- assign card_url = link_block.settings.url -%}
              {%- assign card_open_new_tab = true -%}
            {%- endif -%}
            {%- if link_block.settings.button_text != blank -%}
              {%- assign card_button_text = link_block.settings.button_text -%}
            {%- endif -%}
          {%- endif -%}
          {%- comment -%} Fallback: Men's Athletic Fit Tee ULTRA-SOFT PLAIN TEE → Amazon link https://amzn.to/4aQzyT4 {%- endcomment -%}
          {%- assign title_lower = product.title | downcase -%}
          {%- if card_url == product.url and title_lower contains 'athletic fit tee' -%}
            {%- assign card_url = 'https://amzn.to/4aQzyT4' -%}
            {%- assign card_open_new_tab = true -%}
          {%- endif -%}

          {%- comment -%} Card is never a product link; only the "View on Amazon" button goes to sponsor URL. Clicking the card in the editor opens link settings. {%- endcomment -%}
          <div class="sponsored-picks-card group relative bg-card rounded-2xl overflow-hidden border border-border/60 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/10 transition-all duration-300 block{% if request.design_mode and link_block %} cursor-pointer{% endif %}"{% if link_block %} {{ link_block.shopify_attributes }}{% endif %}>
            <span class="sponsored-picks-badge" aria-hidden="true">{{ 'general.amazon.sponsored' | t | default: 'Sponsored' }}</span>
            <span class="sponsored-picks-card-link block aspect-[4/5] relative overflow-hidden">
              {% if product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" class="sponsored-picks-img w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" width="300" height="375">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'sponsored-picks-img w-full h-full object-cover' }}
              {% endif %}
              <span class="sponsored-picks-card-gradient" aria-hidden="true"></span>
            </span>
            <div class="sponsored-picks-card-content">
              {% if product.vendor != blank %}
                <p class="sponsored-picks-tagline">{{ product.vendor }}</p>
              {% endif %}
              <h3 class="sponsored-picks-title" title="{{ product.title | escape }}">{{ product.title }}</h3>
              {% if product.description != blank %}
                <p class="sponsored-picks-desc-inner line-clamp-2">{{ product.description | strip_html | truncate: 80 }}</p>
              {% endif %}
              <a href="{{ card_url }}" class="sponsored-picks-cta sponsored-picks-cta-link"{% if card_open_new_tab %} target="_blank" rel="noopener noreferrer sponsored"{% endif %}>{{ card_button_text }}</a>
            </div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.show_view_all and collection.url != blank %}
        <div class="text-center mt-10">
          <a href="{{ collection.url }}" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-border text-foreground font-semibold hover:bg-card transition-colors">
            {{ section.settings.view_all_text | default: 'View all' }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="text-center py-12 px-6 rounded-2xl border-2 border-dashed border-border text-foreground/60">
        <p class="mb-2">No products in this collection.</p>
        <p class="text-sm">Select a collection in the section settings above, or add products to the selected collection in Shopify Admin.</p>
      </div>
    {% endif %}

    {%- comment -%} In editor: show hint to add blocks if there are products but no link blocks yet {%- endcomment -%}
    {% if collection != blank and collection.products.size > 0 %}
      <div class="sponsored-picks-add-blocks-hint text-center mt-8 py-4 px-4 rounded-xl bg-muted/40 text-foreground/70 text-sm">
        <p class="font-medium mb-1">Set the "View on Amazon" link</p>
        <p><strong>Click any product card above</strong> to open its link settings in the left sidebar. Add the Amazon (or sponsor) URL for each product. Add blocks so each product has a slot (1st block = 1st product).</p>
’s      </div>
    {% endif %}
  </div>
</section>


<style>
  .sponsored-picks-section .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sponsored-picks-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: rgba(0,0,0,0.75);
    color: #fff;
    border-radius: 0.25rem;
  }
  .sponsored-picks-card {
    display: flex;
    flex-direction: column;
  }
  .sponsored-picks-card-link {
    flex-shrink: 0;
  }
  .sponsored-picks-card-gradient {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
    pointer-events: none;
  }
  .sponsored-picks-card-content {
    padding: 1rem 1rem 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .sponsored-picks-tagline {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--accent));
  }
  .sponsored-picks-title {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    color: hsl(var(--foreground));
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sponsored-picks-desc-inner {
    font-size: 0.8125rem;
    color: hsl(var(--foreground) / 0.6);
    margin: 0;
    line-height: 1.4;
  }
  .sponsored-picks-cta,
  .sponsored-picks-cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #fff;
    background: hsl(var(--accent));
    border-radius: 0.5rem;
    transition: opacity 0.2s, transform 0.2s;
    text-decoration: none;
  }
  .sponsored-picks-cta-link:hover {
    color: #fff;
    opacity: 0.95;
    transform: translateY(-1px);
  }
  .sponsored-picks-card:hover .sponsored-picks-cta,
  .sponsored-picks-card:hover .sponsored-picks-cta-link {
    opacity: 0.95;
    transform: translateY(-1px);
  }
  .product-card-overlay-inner .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media screen and (max-width: 749px) {
    .sponsored-picks-add-blocks-hint { font-size: 0.8125rem; }
  }
</style>

{% schema %}
{
  "name": "Sponsored picks",
  "settings": [
    {
      "type": "header",
      "content": "Product links (sponsor URL per product)"
    },
    {
      "type": "paragraph",
      "content": "Products come from the collection below. **Click any product card** in the preview — the left sidebar will open that product's link settings so you can add the sponsor URL for the \"View product\" button. Add one \"Product link\" block per product (1st block = 1st product, 2nd = 2nd, etc.)."
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID (for anchor links)",
      "default": "shop"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products from this collection appear in the grid. Add a \"Product link\" block for each product (same order: 1st block = 1st product). Click a product card to open its link settings in the sidebar."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sponsored picks"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Handpicked favorites. Click through for the best deals.",
      "info": "Clear to hide."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Default button text",
      "default": "View on Amazon",
      "info": "Used when a product has no block or the block's button text is empty."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all button text",
      "default": "View all"
    }
  ],
  "blocks": [
    {
      "type": "product_link",
      "name": "Product link",
      "limit": 24,
      "settings": [
        {
          "type": "header",
          "content": "View product button link"
        },
        {
          "type": "paragraph",
          "content": "This block is for the product in the same position (1st block = 1st product in the grid). Click that product's card in the preview to open this block and set its link."
        },
        {
          "type": "url",
          "id": "url",
          "label": "Sponsor product link",
          "info": "URL where the \"View product\" button sends customers (e.g. sponsor's or affiliate page). Leave empty to use the product's store page."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text (optional)",
          "placeholder": "View on Amazon",
          "info": "Override the button label for this product."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sponsored picks",
      "settings": {
        "heading": "Sponsored picks",
        "description": "Handpicked favorites. Click through for the best deals.",
        "products_to_show": 8
      },
      "blocks": [
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" }
      ]
    }
  ]
}
{% endschema %}
