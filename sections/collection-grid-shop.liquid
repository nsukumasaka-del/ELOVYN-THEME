  {% comment %}
  Collection grid (shop) – Original overlay style: image card with overlay on hover (title, description, View product).
  No price/Add to cart below; presentation "the way it was before."
{% endcomment %}

<section id="{{ section.settings.section_id | default: 'shop' }}" class="py-24 md:py-32 bg-background">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-4">
        {{ section.settings.heading | default: "Shop the collection" }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="text-lg text-foreground/60 max-w-xl mx-auto">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    {%- assign collection = nil -%}
    {%- if section.settings.collection != blank -%}
      {%- assign collection = collections[section.settings.collection] -%}
    {%- endif -%}
    {%- if collection == nil and collections['frontpage'] != blank -%}
      {%- assign collection = collections['frontpage'] -%}
    {%- endif -%}

    {% if collection != blank and collection.products.size > 0 %}
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 product-grid product-grid--ads">
        {% for product in collection.products limit: section.settings.products_to_show %}
          <div class="product-card product-card--ad group relative bg-card rounded-3xl overflow-hidden border-2 border-border/50 hover:border-accent/40">
            <a href="{{ product.url }}" class="block aspect-[4/5] relative overflow-hidden">
              {% if product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
              {% endif %}
            </a>
            <div class="absolute bottom-0 left-0 right-0 product-card-overlay-inner">
              <div class="absolute inset-0 bg-background/30 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              <div class="relative z-10">
                {% if product.vendor != blank %}
                  <p class="product-card-tagline font-medium text-accent uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity duration-300">{{ product.vendor }}</p>
                {% endif %}
                <h2 class="product-card-title font-bold text-foreground opacity-0 group-hover:opacity-100 transition-opacity duration-300" title="{{ product.title | escape }}">
                  {{ product.title }}
                </h2>
                {% if product.description != blank %}
                  <p class="product-card-desc text-foreground/60 max-w-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300 line-clamp-2">{{ product.description | strip_html | truncate: 100 }}</p>
                {% endif %}
                <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <a href="{{ product.url }}" class="btn-hero text-xs">{{ section.settings.button_text | default: 'View product' }}</a>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.show_view_all and collection.url != blank %}
        <div class="text-center mt-10">
          <a href="{{ collection.url }}" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-border text-foreground font-semibold hover:bg-card transition-colors">
            {{ section.settings.view_all_text | default: 'View all' }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <p class="text-center text-foreground/60">No products in this collection yet. Add products in Shopify Admin → Products and assign them to the collection.</p>
    {% endif %}
  </div>
</section>

<style>
  .product-card-overlay-inner .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

{% schema %}
{
  "name": "Collection grid (shop)",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID (for anchor links)",
      "default": "shop",
      "info": "Optional. e.g. graphic-tees. Leave as 'shop' if not using anchor links."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products from this collection are shown in the overlay card style."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Optional short description for this collection.",
      "info": "Clear in the editor to hide the description."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "View product"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all button text",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Collection grid (shop)"
    }
  ]
}
{% endschema %}
