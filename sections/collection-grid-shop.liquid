{% comment %}
  Collection grid – standard store: price + Add to cart (dropshipping / your products).
  Use for Graphic & custom tees or any collection sold directly.
{% endcomment %}

<section id="{{ section.settings.section_id | default: 'shop' }}" class="py-24 md:py-32 bg-background">
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-4">
        {{ section.settings.heading | default: "Shop the collection" }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="text-lg text-foreground/60 max-w-xl mx-auto">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    {%- assign collection = nil -%}
    {%- if section.settings.collection != blank -%}
      {%- assign collection = collections[section.settings.collection] -%}
    {%- endif -%}
    {%- if collection == nil and collections['frontpage'] != blank -%}
      {%- assign collection = collections['frontpage'] -%}
    {%- endif -%}

    {% if collection != blank and collection.products.size > 0 %}
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 product-grid gap-4 md:gap-6">
        {% for product in collection.products limit: section.settings.products_to_show %}
          {%- assign current_variant = product.selected_or_first_available_variant -%}
          <div class="product-card-shop group bg-card rounded-2xl overflow-hidden border border-border/40 hover:border-border hover:shadow-xl hover:shadow-black/20 transition-all duration-300">
            <a href="{{ product.url }}" class="block aspect-[4/5] relative overflow-hidden">
              {% if product.featured_image != blank %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  width="300"
                  height="375"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover bg-secondary' }}
              {% endif %}
              {% if current_variant.available == false %}
                <span class="absolute inset-0 flex items-center justify-center bg-background/70 text-foreground font-semibold text-sm uppercase tracking-wider">
                  {{ 'products.product.sold_out' | t }}
                </span>
              {% endif %}
            </a>
            <div class="p-4 md:p-5">
              <a href="{{ product.url }}" class="font-semibold text-foreground hover:text-accent transition-colors line-clamp-2 block mb-2">
                {{ product.title }}
              </a>
              <div class="flex items-center gap-2 mb-3 flex-wrap">
                <span class="text-lg font-bold text-foreground">{{ current_variant.price | money }}</span>
                {% if current_variant.compare_at_price > current_variant.price %}
                  <span class="text-sm text-foreground/50 line-through">{{ current_variant.compare_at_price | money }}</span>
                  <span class="text-xs font-medium text-accent bg-accent/20 px-1.5 py-0.5 rounded">
                    {{ current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round }}% off
                  </span>
                {% endif %}
              </div>
              {% if product.has_only_default_variant %}
                {% if current_variant.available %}
                  <form action="{{ routes.cart_add_url }}" method="post" class="cart-add-form">
                    <input type="hidden" name="id" value="{{ current_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <button type="submit" name="add" class="w-full py-2.5 px-4 rounded-xl bg-accent text-accent-foreground font-semibold text-sm hover:opacity-90 transition-opacity">
                      {{ 'products.product.add_to_cart' | t }}
                    </button>
                  </form>
                {% else %}
                  <button type="button" disabled class="w-full py-2.5 px-4 rounded-xl bg-muted text-muted-foreground font-semibold text-sm cursor-not-allowed">
                    {{ 'products.product.sold_out' | t }}
                  </button>
                {% endif %}
              {% else %}
                <a href="{{ product.url }}" class="block w-full py-2.5 px-4 rounded-xl border border-border text-foreground font-semibold text-sm text-center hover:bg-card transition-colors">
                  {{ 'products.product.view_options' | t | default: 'View options' }}
                </a>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.show_view_all and collection.url != blank %}
        <div class="text-center mt-10">
          <a href="{{ collection.url }}" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-border text-foreground font-semibold hover:bg-card transition-colors">
            {{ section.settings.view_all_text | default: 'View all' }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <p class="text-center text-foreground/60">No products in this collection yet. Add products in Shopify Admin → Products and assign them to the collection.</p>
    {% endif %}
  </div>
</section>

<style>
  .product-card-shop .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

{% schema %}
{
  "name": "Collection grid (shop)",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID (for anchor links)",
      "default": "shop",
      "info": "Optional. e.g. graphic-tees. Leave as 'shop' if not using anchor links."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products from this collection are shown with price and Add to cart."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Optional short description for this collection.",
      "info": "Clear in the editor to hide the description."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all button text",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Collection grid (shop)"
    }
  ]
}
{% endschema %}
