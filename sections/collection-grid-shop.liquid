{% comment %}
  Sponsored picks – Products from the collection. Each block (by position) sets the affiliate link for that product.
  Click a product card in the theme editor to open that block's settings in the left sidebar.
{% endcomment %}

<section id="{{ section.settings.section_id | default: 'shop' }}" class="sponsored-picks-section py-24 md:py-32 bg-background" data-sponsored-picks>
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="sponsored-picks-heading text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-4">
        {{ section.settings.heading | default: "Sponsored picks" }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="sponsored-picks-desc text-lg text-foreground/60 max-w-xl mx-auto">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    {%- assign collection = nil -%}
    {%- if section.settings.collection != blank -%}
      {%- assign collection = collections[section.settings.collection] -%}
    {%- endif -%}
    {%- if collection == nil and collections['frontpage'] != blank -%}
      {%- assign collection = collections['frontpage'] -%}
    {%- endif -%}
    {%- assign product_link_blocks = section.blocks | where: 'type', 'product_link' -%}

    {% if collection != blank and collection.products.size > 0 %}
      <div class="sponsored-picks-grid grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {%- comment -%} When we have Product link blocks: loop over section.blocks so the theme editor can select each card and open that block in the sidebar. 1st block = 1st product, 2nd = 2nd, etc. {%- endcomment -%}
        {% if product_link_blocks.size > 0 %}
          {%- assign product_link_index = 0 -%}
          {% for block in section.blocks %}
            {%- if block.type != 'product_link' -%}
              {%- continue -%}
            {%- endif -%}
            {%- if product_link_index >= section.settings.products_to_show -%}
              {%- break -%}
            {%- endif -%}
            {%- assign product = collection.products[product_link_index] -%}
            {%- assign product_link_index = product_link_index | plus: 1 -%}
            {%- if product == nil -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign card_url = product.url -%}
            {%- assign card_button_text = block.settings.button_text | default: section.settings.button_text | default: 'View product' -%}
            {%- assign card_open_new_tab = false -%}
            {%- if block.settings.url != blank -%}
              {%- assign card_url = block.settings.url -%}
              {%- assign card_open_new_tab = true -%}
            {%- endif -%}
            {%- comment -%} Optional: Men's Athletic Fit Tee – use section setting if set {%- endcomment -%}
            {%- assign title_lower = product.title | downcase -%}
            {%- if card_open_new_tab == false and title_lower contains 'athletic fit tee' and section.settings.athletic_fit_tee_amazon_url != blank -%}
              {%- assign card_url = section.settings.athletic_fit_tee_amazon_url -%}
              {%- assign card_open_new_tab = true -%}
            {%- endif -%}

            <div class="sponsored-picks-card group relative bg-card rounded-2xl overflow-hidden border border-border/60 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/10 transition-all duration-300 block{% if request.design_mode %} cursor-pointer{% endif %}" {{ block.shopify_attributes }}>
              <span class="sponsored-picks-badge" aria-hidden="true">{{ 'general.amazon.sponsored' | t | default: 'Sponsored' }}</span>
              <span class="sponsored-picks-card-link block aspect-[4/5] relative overflow-hidden">
                {% if product.featured_image != blank %}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" class="sponsored-picks-img w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" width="300" height="375">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'sponsored-picks-img w-full h-full object-cover' }}
                {% endif %}
                <span class="sponsored-picks-card-gradient" aria-hidden="true"></span>
              </span>
              <div class="sponsored-picks-card-content">
                {% if product.vendor != blank %}
                  <p class="sponsored-picks-tagline">{{ product.vendor }}</p>
                {% endif %}
                <h3 class="sponsored-picks-title" title="{{ product.title | escape }}">{{ product.title }}</h3>
                {% if product.description != blank %}
                  <p class="sponsored-picks-desc-inner line-clamp-2">{{ product.description | strip_html | truncate: 80 }}</p>
                {% endif %}
                {% if request.design_mode %}
                  <span class="sponsored-picks-cta sponsored-picks-cta-link" aria-hidden="true">{{ card_button_text }}</span>
                {% else %}
                  <a href="{{ card_url }}" class="sponsored-picks-cta sponsored-picks-cta-link"{% if card_open_new_tab %} target="_blank" rel="noopener noreferrer sponsored"{% endif %}>{{ card_button_text }}</a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          {%- comment -%} No blocks yet: show collection products so something appears; add blocks to get per-product affiliate links and sidebar click. {%- endcomment -%}
          {% for product in collection.products limit: section.settings.products_to_show %}
            {%- assign card_url = product.url -%}
            {%- assign card_button_text = section.settings.button_text | default: 'View product' -%}
            {%- assign title_lower = product.title | downcase -%}
            {%- assign card_open_new_tab = false -%}
            {%- if title_lower contains 'athletic fit tee' and section.settings.athletic_fit_tee_amazon_url != blank -%}
              {%- assign card_url = section.settings.athletic_fit_tee_amazon_url -%}
              {%- assign card_open_new_tab = true -%}
            {%- endif -%}
            <div class="sponsored-picks-card group relative bg-card rounded-2xl overflow-hidden border border-border/60 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/10 transition-all duration-300">
              <span class="sponsored-picks-badge" aria-hidden="true">{{ 'general.amazon.sponsored' | t | default: 'Sponsored' }}</span>
              <span class="sponsored-picks-card-link block aspect-[4/5] relative overflow-hidden">
                {% if product.featured_image != blank %}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" class="sponsored-picks-img w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" width="300" height="375">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'sponsored-picks-img w-full h-full object-cover' }}
                {% endif %}
                <span class="sponsored-picks-card-gradient" aria-hidden="true"></span>
              </span>
              <div class="sponsored-picks-card-content">
                {% if product.vendor != blank %}
                  <p class="sponsored-picks-tagline">{{ product.vendor }}</p>
                {% endif %}
                <h3 class="sponsored-picks-title" title="{{ product.title | escape }}">{{ product.title }}</h3>
                {% if product.description != blank %}
                  <p class="sponsored-picks-desc-inner line-clamp-2">{{ product.description | strip_html | truncate: 80 }}</p>
                {% endif %}
                <a href="{{ card_url }}" class="sponsored-picks-cta sponsored-picks-cta-link"{% if card_open_new_tab %} target="_blank" rel="noopener noreferrer sponsored"{% endif %}>{{ card_button_text }}</a>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
      {% if section.settings.show_view_all and collection.url != blank %}
        <div class="text-center mt-10">
          <a href="{{ collection.url }}" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-border text-foreground font-semibold hover:bg-card transition-colors">
            {{ section.settings.view_all_text | default: 'View all' }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="text-center py-12 px-6 rounded-2xl border-2 border-dashed border-border text-foreground/60">
        <p class="mb-2">No products in this collection.</p>
        <p class="text-sm">Select a collection in the section settings above, or add products to the selected collection in Shopify Admin.</p>
      </div>
    {% endif %}

    {%- comment -%} In editor: show hint to add blocks if there are products but no link blocks yet {%- endcomment -%}
    {% if request.design_mode and collection != blank and collection.products.size > 0 %}
      <div class="sponsored-picks-add-blocks-hint text-center mt-8 py-4 px-4 rounded-xl bg-muted/40 text-foreground/70 text-sm">
        <p class="font-medium mb-1">Edit product links</p>
        <p>Products come from the selected collection. Add blocks so each product has a slot (1st block = 1st product). Click a product card above to open its block and set the <strong>Product link</strong> (affiliate URL).</p>
’s      </div>
    {% endif %}
  </div>
</section>



<style>
  .sponsored-picks-section .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sponsored-picks-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: rgba(0,0,0,0.75);
    color: #fff;
    border-radius: 0.25rem;
  }
  .sponsored-picks-card {
    display: flex;
    flex-direction: column;
  }
  .sponsored-picks-card-link {
    flex-shrink: 0;
  }
  .sponsored-picks-card-gradient {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
    pointer-events: none;
  }
  .sponsored-picks-card-content {
    padding: 1rem 1rem 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .sponsored-picks-tagline {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--accent));
  }
  .sponsored-picks-title {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    color: hsl(var(--foreground));
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sponsored-picks-desc-inner {
    font-size: 0.8125rem;
    color: hsl(var(--foreground) / 0.6);
    margin: 0;
    line-height: 1.4;
  }
  .sponsored-picks-cta,
  .sponsored-picks-cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #fff;
    background: hsl(var(--accent));
    border-radius: 0.5rem;
    transition: opacity 0.2s, transform 0.2s;
    text-decoration: none;
  }
  .sponsored-picks-cta-link:hover {
    color: #fff;
    opacity: 0.95;
    transform: translateY(-1px);
  }
  .sponsored-picks-card:hover .sponsored-picks-cta,
  .sponsored-picks-card:hover .sponsored-picks-cta-link {
    opacity: 0.95;
    transform: translateY(-1px);
  }
  .product-card-overlay-inner .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media screen and (max-width: 749px) {
    .sponsored-picks-add-blocks-hint { font-size: 0.8125rem; }
  }
</style>

{% schema %}
{
  "name": "Sponsored picks",
  "settings": [
    {
      "type": "header",
      "content": "Product links (sponsor URL per product)"
    },
    {
      "type": "paragraph",
      "content": "Select a **Collection** below. Add one **Product link (affiliate)** block per product (1st block = 1st product). In each block, set **Amazon or affiliate link** so the \"View product\" button uses your link. Click a product card in the preview to open its block here."
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID (for anchor links)",
      "default": "shop"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products from this collection appear in the grid. Add one block per product to set each product's affiliate link."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sponsored picks"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Handpicked favorites. Click through for the best deals.",
      "info": "Clear to hide."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Default button text",
      "default": "View product",
      "info": "Used when a block's button text is left empty."
    },
    {
      "type": "header",
      "content": "Men's Athletic Fit Tee (optional)"
    },
    {
      "type": "url",
      "id": "athletic_fit_tee_amazon_url",
      "label": "Amazon link for Athletic Fit Tee",
      "info": "Add a URL to make the \"View product\" button for \"Men's Athletic Fit Tee ULTRA-SOFT PLAIN TEE\" go to this link (e.g. Amazon). Leave blank to use the normal product page."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all button text",
      "default": "View all"
    }
  ],
  "blocks": [
    {
      "type": "product_link",
      "name": "Product link (affiliate)",
      "limit": 24,
      "settings": [
        {
          "type": "header",
          "content": "Affiliate link for this product"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Amazon or affiliate link",
          "info": "Paste your Amazon (e.g. amzn.to/xxxxx) or other affiliate URL. The \"View product\" button will use this link. Block 1 = 1st product, Block 2 = 2nd, etc."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text (optional)",
          "placeholder": "View product",
          "info": "Label for the button (e.g. \"View product\" or \"View on Amazon\")."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sponsored picks",
      "settings": {
        "heading": "Sponsored picks",
        "description": "Handpicked favorites. Click through for the best deals.",
        "products_to_show": 8
      },
      "blocks": [
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" }
      ]
    }
  ]
}
{% endschema %}
