{% comment %}
  Collection grid (shop) / Sponsored picks – Ad-optimized product cards with optional per-product links.
  Add "Product link" blocks to set a custom URL for each product (e.g. affiliate links). Order matches product order.
{% endcomment %}

<section id="{{ section.settings.section_id | default: 'shop' }}" class="sponsored-picks-section py-24 md:py-32 bg-background" data-sponsored-picks>
  <div class="container mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="sponsored-picks-heading text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-4">
        {{ section.settings.heading | default: "Sponsored picks" }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="sponsored-picks-desc text-lg text-foreground/60 max-w-xl mx-auto">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    {%- assign collection = nil -%}
    {%- if section.settings.collection != blank -%}
      {%- assign collection = collections[section.settings.collection] -%}
    {%- endif -%}
    {%- if collection == nil and collections['frontpage'] != blank -%}
      {%- assign collection = collections['frontpage'] -%}
    {%- endif -%}

    {% if collection != blank and collection.products.size > 0 %}
      <div class="sponsored-picks-grid grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {% for product in collection.products limit: section.settings.products_to_show %}
          {%- assign product_index = forloop.index0 -%}
          {%- assign link_block = nil -%}
          {%- assign link_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'product_link' -%}
              {%- if link_count == product_index -%}
                {%- assign link_block = block -%}
                {%- break -%}
              {%- endif -%}
              {%- assign link_count = link_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- assign card_url = product.url -%}
          {%- assign card_button_text = section.settings.button_text | default: 'View product' -%}
          {%- assign card_open_new_tab = false -%}
          {%- if link_block != nil and link_block.settings.url != blank -%}
            {%- assign card_url = link_block.settings.url -%}
            {%- assign card_open_new_tab = true -%}
            {%- if link_block.settings.button_text != blank -%}
              {%- assign card_button_text = link_block.settings.button_text -%}
            {%- endif -%}
          {%- endif -%}

          <a href="{{ card_url }}" class="sponsored-picks-card group relative bg-card rounded-2xl overflow-hidden border border-border/60 hover:border-accent/50 hover:shadow-lg hover:shadow-accent/10 transition-all duration-300 block"{% if card_open_new_tab %} target="_blank" rel="noopener noreferrer sponsored"{% endif %}{% if link_block %} {{ link_block.shopify_attributes }}{% endif %}>
            <span class="sponsored-picks-badge" aria-hidden="true">{{ 'general.amazon.sponsored' | t | default: 'Sponsored' }}</span>
            <span class="sponsored-picks-card-link block aspect-[4/5] relative overflow-hidden">
              {% if product.featured_image != blank %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" class="sponsored-picks-img w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" width="300" height="375">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'sponsored-picks-img w-full h-full object-cover' }}
              {% endif %}
              <span class="sponsored-picks-card-gradient" aria-hidden="true"></span>
            </span>
            <div class="sponsored-picks-card-content">
              {% if product.vendor != blank %}
                <p class="sponsored-picks-tagline">{{ product.vendor }}</p>
              {% endif %}
              <h3 class="sponsored-picks-title" title="{{ product.title | escape }}">{{ product.title }}</h3>
              {% if product.description != blank %}
                <p class="sponsored-picks-desc-inner line-clamp-2">{{ product.description | strip_html | truncate: 80 }}</p>
              {% endif %}
              <span class="sponsored-picks-cta">{{ card_button_text }}</span>
            </div>
          </a>
        {% endfor %}
      </div>
      {% if section.settings.show_view_all and collection.url != blank %}
        <div class="text-center mt-10">
          <a href="{{ collection.url }}" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-border text-foreground font-semibold hover:bg-card transition-colors">
            {{ section.settings.view_all_text | default: 'View all' }}
          </a>
        </div>
      {% endif %}
    {% else %}
      <p class="text-center text-foreground/60">No products in this collection yet. Add products in Shopify Admin → Products and assign them to the collection.</p>
    {% endif %}
  </div>
</section>

<style>
  .sponsored-picks-section .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sponsored-picks-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: rgba(0,0,0,0.75);
    color: #fff;
    border-radius: 0.25rem;
  }
  .sponsored-picks-card {
    display: flex;
    flex-direction: column;
  }
  .sponsored-picks-card-link {
    flex-shrink: 0;
  }
  .sponsored-picks-card-gradient {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
    pointer-events: none;
  }
  .sponsored-picks-card-content {
    padding: 1rem 1rem 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .sponsored-picks-tagline {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--accent));
  }
  .sponsored-picks-title {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    color: hsl(var(--foreground));
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sponsored-picks-desc-inner {
    font-size: 0.8125rem;
    color: hsl(var(--foreground) / 0.6);
    margin: 0;
    line-height: 1.4;
  }
  .sponsored-picks-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #fff;
    background: hsl(var(--accent));
    border-radius: 0.5rem;
    transition: opacity 0.2s, transform 0.2s;
  }
  .sponsored-picks-card:hover .sponsored-picks-cta {
    opacity: 0.95;
    transform: translateY(-1px);
  }
  .product-card-overlay-inner .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

{% schema %}
{
  "name": "Collection grid (shop)",
  "settings": [
    {
      "type": "header",
      "content": "Sponsored product links"
    },
    {
      "type": "paragraph",
      "content": "Add 'Product link' blocks to set a custom URL for each sponsored product (e.g. affiliate or external links). The first block applies to the first product, the second to the second product, and so on. Leave a block's URL empty to use the product's normal store link."
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID (for anchor links)",
      "default": "shop",
      "info": "Optional. e.g. sponsored-picks. Used for anchor links."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products from this collection are shown. Often used for Sponsored picks."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sponsored picks"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Handpicked favorites. Click through for the best deals.",
      "info": "Clear in the editor to hide the description."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Default button text",
      "default": "View product",
      "info": "Used when a product has no custom link block or the block's button text is empty."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all button text",
      "default": "View all"
    }
  ],
  "blocks": [
    {
      "type": "product_link",
      "name": "Product link",
      "limit": 24,
      "settings": [
        {
          "type": "header",
          "content": "Link for this product"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Product link URL",
          "info": "Set the link for this product (affiliate, external, or store page). Leave empty to use the product's store page."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text (optional)",
          "placeholder": "View product",
          "info": "Override the button label for this product (e.g. 'View on Amazon', 'Shop now')."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection grid (shop)",
      "blocks": [
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" },
        { "type": "product_link" }
      ]
    }
  ]
}
{% endschema %}
