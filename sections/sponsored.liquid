{% comment %}
  Sponsored section – block-based. Each block is one sponsored product with:
  Select Product, Affiliate Link, Button Label. Settings appear in theme editor sidebar when you click a block.
{% endcomment %}

<section class="sponsored-section py-16 md:py-24 bg-background" {{ section.shopify_attributes }}>
  <div class="container mx-auto px-6">
    {% if section.settings.heading != blank %}
      <header class="text-center mb-12 md:mb-16">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-foreground mb-4">
          {{ section.settings.heading }}
        </h2>
        {% if section.settings.description != blank %}
          <div class="text-lg text-foreground/60 max-w-2xl mx-auto">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 product-grid product-grid--ads gap-4 md:gap-6">
        {% for block in section.blocks %}
          {%- assign product = block.settings.product -%}
          {%- if product == blank and block.settings.product != blank -%}
            {%- assign product = all_products[block.settings.product] -%}
          {%- endif -%}

          {% if product != blank %}
            <div class="sponsored-product product-card product-card--ad group relative bg-card rounded-3xl overflow-hidden border-2 border-border/50 hover:border-accent/40" {{ block.shopify_attributes }}>
              <span class="product-card__ad-badge" aria-hidden="true">{{ 'general.amazon.sponsored' | t | default: 'Sponsored' }}</span>
              <div class="aspect-[4/5] relative overflow-hidden">
                {% if block.settings.affiliate_url != blank %}
                  <a href="{{ block.settings.affiliate_url }}" target="_blank" rel="noopener noreferrer" class="block w-full h-full">
                    {% if product.featured_image != blank %}
                      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy">
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
                    {% endif %}
                  </a>
                {% else %}
                  <a href="{{ product.url }}" class="block w-full h-full">
                    {% if product.featured_image != blank %}
                      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy">
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
                    {% endif %}
                  </a>
                {% endif %}
              </div>
              <div class="absolute bottom-0 left-0 right-0 product-card-overlay-inner">
                <div class="absolute inset-0 bg-background/30 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                <div class="relative z-10">
                  {% if product.vendor != blank %}
                    <p class="product-card-tagline font-medium text-accent uppercase tracking-wider opacity-0 group-hover:opacity-100 transition-opacity duration-300">{{ product.vendor }}</p>
                  {% endif %}
                  {% if block.settings.affiliate_url != blank %}
                    <a href="{{ block.settings.affiliate_url }}" target="_blank" rel="noopener noreferrer" class="product-card-title font-bold text-foreground opacity-0 group-hover:opacity-100 transition-opacity duration-300 block" title="{{ product.title | escape }}">{{ product.title }}</a>
                  {% else %}
                    <a href="{{ product.url }}" class="product-card-title font-bold text-foreground opacity-0 group-hover:opacity-100 transition-opacity duration-300 block" title="{{ product.title | escape }}">{{ product.title }}</a>
                  {% endif %}
                  {% if product.description != blank %}
                    <p class="product-card-desc text-foreground/60 max-w-xs opacity-0 group-hover:opacity-100 transition-opacity duration-300 line-clamp-2">{{ product.description | strip_html | truncate: 100 }}</p>
                  {% endif %}
                  <div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    {% if block.settings.affiliate_url != blank %}
                      <a href="{{ block.settings.affiliate_url }}" class="btn-hero text-xs button affiliate-button" target="_blank" rel="noopener noreferrer">{{ block.settings.button_label | default: 'View Product' }}</a>
                    {% else %}
                      <a href="{{ product.url }}" class="btn-hero text-xs button">{{ 'general.amazon.view_product' | t | default: 'View Product' }}</a>
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          {% else %}
            <div class="sponsored-product product-card product-card--ad group relative bg-card rounded-3xl overflow-hidden border-2 border-border/50 border-dashed" {{ block.shopify_attributes }}>
              <div class="aspect-[4/5] flex items-center justify-center text-foreground/50 text-sm px-4">
                {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover opacity-50' }}
              </div>
              <div class="p-4 text-center text-foreground/60 text-sm">
                Select a product in the block settings
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="text-center py-12 px-6 rounded-2xl border-2 border-dashed border-border text-foreground/60">
        <p class="mb-2">No sponsored products yet.</p>
        <p class="text-sm">Click <strong>Add block</strong> in the left sidebar, then <strong>Sponsored Product</strong>. Select a product and set the affiliate link and button label.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Sponsored",
  "tag": "section",
  "class": "section-sponsored",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sponsored"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "sponsored_product",
      "name": "Sponsored Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "url",
          "id": "affiliate_url",
          "label": "Affiliate Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "View Product"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Sponsored",
      "blocks": [
        { "type": "sponsored_product" },
        { "type": "sponsored_product" },
        { "type": "sponsored_product" }
      ]
    }
  ]
}
{% endschema %}
